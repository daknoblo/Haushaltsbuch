package web

import (
	"strconv"

	"github.com/daknoblo/Haushaltsbuch/internal/store"
)

templ BookingsPage(nav Nav, vm BookingsVM) {
	@Layout(nav) {
		@pageHeading(T(ctx, "bookings.title"), T(ctx, "bookings.subtitle")) {
			<div class="ml-auto flex flex-wrap items-center gap-2 no-print">
				@newBookingButton(nav.Month, store.DirIncome, T(ctx, "bookings.addIncome"))
				@newBookingButton(nav.Month, store.DirExpense, T(ctx, "bookings.addExpense"))
			</div>
		}
		if nav.ActiveHousehold.ID == 0 {
			@noHousehold()
		} else {
			// The list reloads itself whenever the dialog reports a change, so an
			// edit never costs a page reload.
			<div id="booking-list" hx-get={ "/bookings/list?m=" + nav.Month } hx-trigger="hb:changed from:body" hx-swap="outerHTML">
				@BookingList(vm)
			</div>
			<div id="booking-dialog"></div>
		}
	}
}

templ newBookingButton(month string, dir store.Direction, label string) {
	<button
		class={ "no-print", templ.KV("btn-primary", dir == store.DirExpense), templ.KV("btn-ghost", dir == store.DirIncome) }
		hx-post={ "/bookings/new?m=" + month + "&direction=" + string(dir) }
		hx-target="#booking-dialog"
		hx-swap="innerHTML"
	>{ label }</button>
}

templ BookingList(vm BookingsVM) {
	<div id="booking-list" hx-get={ "/bookings/list?m=" + vm.Month } hx-trigger="hb:changed from:body" hx-swap="outerHTML">
		<div class="grid gap-4">
			@balanceStrip(vm)
			if vm.Empty() {
				<div class="card text-center">
					<p class="text-slate-600 dark:text-slate-400">{ T(ctx, "bookings.empty") }</p>
				</div>
			} else {
				if len(vm.Income) > 0 {
					<h2 class="mt-2 text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
						{ T(ctx, "bookings.incomeHeading") }
					</h2>
					for _, g := range vm.Income {
						@categoryGroup(g)
					}
				}
				if len(vm.Expenses) > 0 {
					<h2 class="mt-2 text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
						{ T(ctx, "bookings.expenseHeading") }
					</h2>
					for _, g := range vm.Expenses {
						@categoryGroup(g)
					}
				}
			}
		</div>
	</div>
}

// balanceStrip keeps the effect of an edit visible while editing.
templ balanceStrip(vm BookingsVM) {
	<div class="card-tight">
		<div class="grid grid-cols-3 divide-x divide-slate-200 dark:divide-slate-800">
			<div class="px-4 py-3">
				<div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">{ T(ctx, "overview.income") }</div>
				<div class="tnum mt-1 text-lg font-semibold text-emerald-600 dark:text-emerald-400">{ FormatEUR(vm.Report.IncomeCents) }</div>
			</div>
			<div class="px-4 py-3">
				<div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">{ T(ctx, "overview.expenses") }</div>
				<div class="tnum mt-1 text-lg font-semibold text-slate-900 dark:text-slate-100">{ FormatEUR(vm.Report.ExpenseCents) }</div>
			</div>
			<div class="px-4 py-3">
				<div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">{ T(ctx, "overview.balance") }</div>
				<div class="tnum mt-1 text-lg font-semibold">
					@signedMoney(vm.Report.BalanceCents)
				</div>
			</div>
		</div>
	</div>
}

templ categoryGroup(g CategoryGroup) {
	<div class="card-tight">
		<div class="card-head">
			@categoryIcon(g.Category)
			<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ g.Category.Name }</h2>
			<span class="badge ml-auto">{ FormatEUR(g.TotalCents) } { T(ctx, "bookings.perMonth") }</span>
		</div>
		<div class="card-body grid gap-1.5">
			for _, b := range g.Bookings {
				@bookingRow(b)
			}
		</div>
	</div>
}

// bookingRow is a summary; every edit happens in the dialog it opens.
templ bookingRow(b BookingRow) {
	<button
		type="button"
		id={ b.DOMID() }
		class="booking-row"
		hx-get={ b.EditURL() + "?m=" + b.Month }
		hx-target="#booking-dialog"
		hx-swap="innerHTML"
	>
		<span class="min-w-0 flex-1 truncate text-left font-medium text-slate-900 dark:text-slate-100">
			if b.Booking.Name == "" {
				<span class="italic text-slate-400 dark:text-slate-500">{ T(ctx, "bookings.unnamed") }</span>
			} else {
				{ b.Booking.Name }
			}
		</span>
		<span class="hidden items-center gap-1.5 sm:flex">
			<span class="badge">{ RhythmLabel(ctx, b.Booking) }</span>
			if b.Discounted() {
				<span class="badge badge-ok">{ FormatEUR(b.AmountCents()) }</span>
			}
			if !b.IsIncome() && b.ShareCount() > 1 {
				<span class="badge">÷ { strconv.Itoa(b.ShareCount()) }</span>
			}
		</span>
		<span class="tnum shrink-0 text-right text-sm font-semibold">
			if b.IsIncome() {
				<span class="text-emerald-600 dark:text-emerald-400">{ FormatEUR(b.MonthlyCents()) }</span>
			} else {
				<span class="text-slate-900 dark:text-slate-100">{ FormatEUR(b.MonthlyCents()) }</span>
			}
			<span class="font-normal text-slate-400 dark:text-slate-500">{ T(ctx, "bookings.perMonthShort") }</span>
		</span>
	</button>
}
