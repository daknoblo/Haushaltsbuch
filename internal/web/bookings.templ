package web

import "github.com/daknoblo/Haushaltsbuch/internal/store"

templ BookingsPage(nav Nav, vm BookingsVM) {
	@Layout(nav) {
		@pageHeading(T(ctx, "bookings.title"), T(ctx, "bookings.subtitle")) {
			<div class="ml-auto flex flex-wrap items-center gap-2 no-print">
				@newBookingButton(nav.Month, store.DirIncome, T(ctx, "bookings.addIncome"))
				@newBookingButton(nav.Month, store.DirExpense, T(ctx, "bookings.addExpense"))
			</div>
		}
		if nav.ActiveHousehold.ID == 0 {
			@noHousehold()
		} else {
			// The list reloads itself whenever the dialog reports a change, so an
			// edit never costs a page reload.
			<div id="booking-list" hx-get={ vm.ListURL() } hx-trigger="hb:changed from:body" hx-swap="outerHTML">
				@BookingList(vm)
			</div>
			<div id="booking-dialog"></div>
		}
	}
}

templ newBookingButton(month string, dir store.Direction, label string) {
	<button
		class={ "no-print", templ.KV("btn-expense", dir == store.DirExpense), templ.KV("btn-income", dir == store.DirIncome) }
		hx-post={ "/bookings/new?m=" + month + "&direction=" + string(dir) }
		hx-target="#booking-dialog"
		hx-swap="innerHTML"
	>{ label }</button>
}

templ BookingList(vm BookingsVM) {
	<div id="booking-list" hx-get={ vm.ListURL() } hx-trigger="hb:changed from:body" hx-swap="outerHTML">
		<div class="grid gap-4">
			@balanceStrip(vm)
			if vm.Empty() {
				<div class="card text-center">
					<p class="text-slate-600 dark:text-slate-400">{ T(ctx, "bookings.empty") }</p>
				</div>
			} else {
				<div class="card-tight">
					@sortBar(vm)
					<div class="card-body grid gap-1.5">
						for _, b := range vm.Bookings {
							@bookingRow(b)
						}
					</div>
				</div>
			}
		</div>
	</div>
}

// sortBar lets the list be read the way the question of the moment needs it.
templ sortBar(vm BookingsVM) {
	<div class="card-head no-print">
		<span class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">{ T(ctx, "bookings.sort") }</span>
		<div class="flex flex-wrap items-center gap-1">
			for _, o := range vm.SortOptions(ctx) {
				if o.Active {
					<span class="period-chip period-chip-active">{ o.Label }</span>
				} else {
					<a class="period-chip" href={ templ.SafeURL(o.URL) }>{ o.Label }</a>
				}
			}
		</div>
	</div>
}

// balanceStrip keeps the effect of an edit visible while editing.
templ balanceStrip(vm BookingsVM) {
	<div class="card-tight">
		<div class="grid grid-cols-3 divide-x divide-slate-200 dark:divide-slate-800">
			<div class="px-4 py-3 text-center">
				<div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">{ T(ctx, "overview.income") }</div>
				<div class="tnum mt-1 text-lg font-semibold text-emerald-600 dark:text-emerald-400">{ FormatEUR(vm.Report.IncomeCents) }</div>
			</div>
			<div class="px-4 py-3 text-center">
				<div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">{ T(ctx, "bookings.allExpenses") }</div>
				<div class="tnum mt-1 text-lg font-semibold text-slate-900 dark:text-slate-100">{ FormatEUR(vm.Report.ExpenseCents) }</div>
			</div>
			<div class="px-4 py-3 text-center">
				<div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">{ T(ctx, "bookings.left") }</div>
				<div class="tnum mt-1 text-lg font-semibold">
					@signedMoney(vm.Report.BalanceCents)
				</div>
			</div>
		</div>
	</div>
}

// bookingRow is a summary; every edit happens in the dialog it opens. The
// marker, the icon and the two badges are what makes a booking recognisable
// without reading a single word.
templ bookingRow(b BookingRow) {
	<button
		type="button"
		id={ b.DOMID() }
		class={ "booking-row", templ.KV("booking-row-off", !b.ActiveInMonth()) }
		hx-get={ b.EditURL() + "?m=" + b.Month }
		hx-target="#booking-dialog"
		hx-swap="innerHTML"
	>
		<span
			class={ "dir-mark", templ.KV("dir-in", b.IsIncome()), templ.KV("dir-out", !b.IsIncome()) }
			title={ DirectionLabel(ctx, b.Booking.Direction) }
		>
			if b.IsIncome() {
				↑
			} else {
				↓
			}
		</span>
		@categoryIcon(b.Category)
		<span class="min-w-0 flex-1 truncate text-left font-medium text-slate-900 dark:text-slate-100">
			if b.Booking.Name == "" {
				<span class="italic text-slate-400 dark:text-slate-500">{ T(ctx, "bookings.unnamed") }</span>
			} else {
				{ b.Booking.Name }
			}
		</span>
		<span class="row-flags">
			if !b.ActiveInMonth() {
				<span class="badge badge-muted">{ T(ctx, "bookings.notInMonth") }</span>
			}
			if b.Discounted() {
				<span class="badge badge-ok">{ FormatEUR(b.AmountCents()) }</span>
			}
			if b.ShowDuePoint() {
				<span class="badge badge-muted">{ DuePointLabel(ctx, b.Booking.DuePoint) }</span>
			}
			if !b.IsIncome() && !b.Booking.Settle {
				<span class="badge badge-muted">{ T(ctx, "bookings.noSettle") }</span>
			}
			if b.MemberCount() > 1 && len(b.Carriers) == 0 {
				<span class="badge badge-warn">{ T(ctx, "overview.unassigned") }</span>
			}
		</span>
		<span class="row-meta">
			<span class="meta-cell meta-date">
				if b.DateLabel(ctx) != "" {
					<span class="date-chip">{ b.DateLabel(ctx) }</span>
				}
			</span>
			<span class="meta-cell meta-rhythm">
				<span class={ "badge truncate", FrequencyBadgeClass(b.Booking.Frequency) } title={ RhythmLabel(ctx, b.Booking) }>
					{ RhythmLabel(ctx, b.Booking) }
				</span>
			</span>
			<span class="meta-cell meta-split">
				if b.MemberCount() > 1 {
					if b.IsShared() {
						<span class="badge badge-sky">{ T(ctx, "bookings.shared") }</span>
					} else if len(b.Carriers) == 1 {
						<span class="badge badge-muted">{ T(ctx, "bookings.alone") }</span>
					}
				}
			</span>
			<span class="meta-cell meta-class">
				if !b.IsIncome() {
					<span class="class-chip">
						<span class={ "inline-block h-2 w-2 shrink-0 rounded-full", BudgetClassDot(b.Booking.BudgetClass) }></span>
						<span class="truncate">{ BudgetClassLabel(ctx, b.Booking.BudgetClass) }</span>
					</span>
				}
			</span>
			if b.MemberCount() > 1 {
				for _, m := range b.Members {
					<span class="meta-cell meta-member">
						if b.Carries(m.ID) || (b.IsPayer(m.ID) && b.PayerCarriesNothing()) {
							@memberChip(m, b.IsPayer(m.ID))
						}
					</span>
				}
			}
		</span>
		<span class="tnum w-[8.5rem] shrink-0 text-right text-sm font-semibold">
			if b.IsIncome() {
				<span class="text-emerald-600 dark:text-emerald-400">{ FormatEUR(b.MonthlyCents()) }</span>
			} else {
				<span class="text-slate-900 dark:text-slate-100">{ FormatEUR(b.MonthlyCents()) }</span>
			}
			<span class="font-normal text-slate-400 dark:text-slate-500">{ T(ctx, "bookings.perMonthShort") }</span>
		</span>
	</button>
}

// memberChip names one person in their own colour; the one who fronts the
// money is marked, because a name alone does not say who paid.
templ memberChip(m store.Member, pays bool) {
	<span
		class={ "member-chip", templ.KV("member-chip-payer", pays) }
		style={ tagStyle(m.Color) }
		title={ MemberRoleTitle(ctx, m, pays) }
	>
		if pays {
			<span aria-hidden="true">€</span>
		}
		{ m.Name }
	</span>
}
