package web

import (
	"strconv"

	"github.com/daknoblo/Haushaltsbuch/internal/store"
)

templ SettingsPage(nav Nav, vm SettingsVM) {
	@Layout(nav) {
		@pageHeading("Einstellungen", "Haushalte, Personen, Sektionen und Kategorien verwalten.") {
		}
		<div class="grid gap-4 lg:grid-cols-2">
			<div class="card-tight" id="haushalte">
				<div class="card-head"><h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">Haushalte</h2></div>
				<div class="card-body">
					<div id="household-list" class="grid gap-2">
						for _, h := range vm.Households {
							@HouseholdRowView(h, vm.ActiveID)
						}
					</div>
					<form
						class="mt-3 flex gap-2"
						hx-post="/households"
						hx-target="#household-list"
						hx-swap="beforeend"
						data-reset-on-success
					>
						<input class="input flex-1" type="text" name="name" placeholder="Neuer Haushalt" required/>
						<button class="btn-primary shrink-0" type="submit">Hinzufügen</button>
					</form>
				</div>
			</div>
			<div class="card-tight" id="personen">
				<div class="card-head"><h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">Personen</h2></div>
				<div class="card-body">
					<div id="member-list" class="grid gap-2">
						for _, m := range vm.Members {
							@MemberRowView(m)
						}
					</div>
					<form
						class="mt-3 flex gap-2"
						hx-post="/members"
						hx-target="#member-list"
						hx-swap="beforeend"
						data-reset-on-success
					>
						<input class="input flex-1" type="text" name="name" placeholder="Name" required/>
						<button class="btn-primary shrink-0" type="submit">Hinzufügen</button>
					</form>
				</div>
			</div>
			<div class="card-tight" id="sektionen">
				<div class="card-head"><h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">Sektionen</h2></div>
				<div class="card-body">
					<div id="section-list" class="grid gap-2">
						for _, s := range vm.Sections {
							@SectionRowView(s)
						}
					</div>
					<form
						class="mt-3 flex gap-2"
						hx-post="/sections"
						hx-target="#section-list"
						hx-swap="beforeend"
						data-reset-on-success
					>
						<input class="input flex-1" type="text" name="name" placeholder="Neue Sektion" required/>
						<button class="btn-primary shrink-0" type="submit">Hinzufügen</button>
					</form>
				</div>
			</div>
			<div class="card-tight" id="kategorien">
				<div class="card-head"><h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">Kategorien</h2></div>
				<div class="card-body">
					<div id="category-list" class="grid gap-2">
						for _, c := range vm.Categories {
							@CategoryRowView(c)
						}
					</div>
					<form
						class="mt-3 flex gap-2"
						hx-post="/categories"
						hx-target="#category-list"
						hx-swap="beforeend"
						data-reset-on-success
					>
						<input class="input flex-1" type="text" name="name" placeholder="Neue Kategorie" required/>
						<button class="btn-primary shrink-0" type="submit">Hinzufügen</button>
					</form>
				</div>
			</div>
		</div>
	}
}

templ HouseholdRowView(h store.Household, activeID int64) {
	<div id={ "hh-" + strconv.FormatInt(h.ID, 10) } class="flex items-center gap-2 border-b border-slate-200/70 pb-2 last:border-0 last:pb-0 dark:border-slate-800/60">
		<form
			class="min-w-0 flex-1"
			hx-post={ "/households/" + strconv.FormatInt(h.ID, 10) }
			hx-trigger="change, keyup changed delay:700ms"
			hx-target="this"
			hx-swap="none"
		>
			<input class="input" type="text" name="name" value={ h.Name }/>
		</form>
		if h.ID == activeID {
			<span class="badge badge-ok shrink-0">Aktiv</span>
		} else {
			<button
				class="btn-ghost shrink-0"
				hx-post={ "/households/activate?id=" + strconv.FormatInt(h.ID, 10) }
				hx-swap="none"
			>aktivieren</button>
		}
		@moveButtons("/households/" + strconv.FormatInt(h.ID, 10))
		<button
			class="btn-icon shrink-0 no-print"
			hx-post={ "/households/" + strconv.FormatInt(h.ID, 10) + "/delete" }
			hx-swap="none"
			hx-confirm="Haushalt inkl. aller Daten löschen?"
			aria-label="Löschen"
		>✕</button>
	</div>
}

templ MemberRowView(m store.Member) {
	<div id={ "mem-" + strconv.FormatInt(m.ID, 10) } class="flex items-center gap-2 border-b border-slate-200/70 pb-2 last:border-0 last:pb-0 dark:border-slate-800/60">
		<form
			class="flex min-w-0 flex-1 items-center gap-2"
			hx-post={ "/members/" + strconv.FormatInt(m.ID, 10) }
			hx-trigger="change, keyup changed delay:700ms"
			hx-target="this"
			hx-swap="none"
		>
			<input class="h-9 w-10 shrink-0 cursor-pointer rounded-md border border-slate-300 bg-transparent p-0.5 dark:border-slate-700" type="color" name="color" value={ ColorOr(m.Color) } aria-label="Farbe"/>
			<input class="input" type="text" name="name" value={ m.Name } aria-label="Name"/>
		</form>
		@moveButtons("/members/" + strconv.FormatInt(m.ID, 10))
		<button
			class="btn-icon shrink-0 no-print"
			hx-post={ "/members/" + strconv.FormatInt(m.ID, 10) + "/delete" }
			hx-target={ "#mem-" + strconv.FormatInt(m.ID, 10) }
			hx-swap="outerHTML"
			hx-confirm="Person löschen?"
			aria-label="Löschen"
		>✕</button>
	</div>
}

templ SectionRowView(s store.Section) {
	<div id={ "sec-" + strconv.FormatInt(s.ID, 10) } class="flex items-center gap-2 border-b border-slate-200/70 pb-2 last:border-0 last:pb-0 dark:border-slate-800/60">
		<form
			class="min-w-0 flex-1"
			hx-post={ "/sections/" + strconv.FormatInt(s.ID, 10) }
			hx-trigger="change, keyup changed delay:700ms"
			hx-target="this"
			hx-swap="none"
		>
			<input class="input" type="text" name="name" value={ s.Name }/>
		</form>
		@moveButtons("/sections/" + strconv.FormatInt(s.ID, 10))
		<button
			class="btn-icon shrink-0 no-print"
			hx-post={ "/sections/" + strconv.FormatInt(s.ID, 10) + "/delete" }
			hx-target={ "#sec-" + strconv.FormatInt(s.ID, 10) }
			hx-swap="outerHTML"
			hx-confirm="Sektion löschen? Ausgaben bleiben erhalten."
			aria-label="Löschen"
		>✕</button>
	</div>
}

templ CategoryRowView(c store.Category) {
	<div id={ "cat-" + strconv.FormatInt(c.ID, 10) } class="flex items-center gap-2 border-b border-slate-200/70 pb-2 last:border-0 last:pb-0 dark:border-slate-800/60">
		<form
			class="min-w-0 flex-1"
			hx-post={ "/categories/" + strconv.FormatInt(c.ID, 10) }
			hx-trigger="change, keyup changed delay:700ms"
			hx-target="this"
			hx-swap="none"
		>
			<input class="input" type="text" name="name" value={ c.Name }/>
		</form>
		<button
			class="btn-icon shrink-0 no-print"
			hx-post={ "/categories/" + strconv.FormatInt(c.ID, 10) + "/delete" }
			hx-target={ "#cat-" + strconv.FormatInt(c.ID, 10) }
			hx-swap="outerHTML"
			hx-confirm="Kategorie löschen?"
			aria-label="Löschen"
		>✕</button>
	</div>
}
