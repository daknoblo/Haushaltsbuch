package web

import (
	"strconv"

	"github.com/daknoblo/Haushaltsbuch/internal/store"
)

templ SettingsPage(nav Nav, vm SettingsVM) {
	@Layout(nav) {
		@pageHeading(T(ctx, "settings.title"), T(ctx, "settings.subtitle")) {
		}
		<div class="grid gap-4 lg:grid-cols-2">
			<div class="card-tight" id="households">
				<div class="card-head"><h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "settings.households") }</h2></div>
				<div class="card-body">
					<div id="household-list" class="grid gap-2">
						for _, h := range vm.Households {
							@HouseholdRowView(h, vm.ActiveID)
						}
					</div>
					<form
						class="mt-3 flex gap-2"
						hx-post="/households"
						hx-target="#household-list"
						hx-swap="beforeend"
						data-reset-on-success
					>
						<input class="input flex-1" type="text" name="name" placeholder={ T(ctx, "settings.newHousehold") } required/>
						<button class="btn-primary shrink-0" type="submit">{ T(ctx, "action.add") }</button>
					</form>
				</div>
			</div>
			<div class="card-tight" id="people">
				<div class="card-head"><h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "overview.people") }</h2></div>
				<div class="card-body">
					<div id="member-list" class="grid gap-2">
						for _, m := range vm.Members {
							@MemberRowView(m)
						}
					</div>
					<form
						class="mt-3 flex gap-2"
						hx-post="/members"
						hx-target="#member-list"
						hx-swap="beforeend"
						data-reset-on-success
					>
						<input class="input flex-1" type="text" name="name" placeholder={ T(ctx, "settings.name") } required/>
						<button class="btn-primary shrink-0" type="submit">{ T(ctx, "action.add") }</button>
					</form>
				</div>
			</div>
			<div class="card-tight lg:col-span-2" id="categories">
				<div class="card-head"><h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "settings.categories") }</h2></div>
				<div class="card-body">
					<div id="category-list" class="grid gap-2">
						for _, c := range vm.Categories {
							@CategoryRowView(c, vm.UsageOf(c.ID), vm.Icons)
						}
					</div>
					<form
						class="mt-3 flex flex-wrap gap-2"
						hx-post="/categories"
						hx-swap="none"
						data-reset-on-success
					>
						<input class="input min-w-0 flex-1" type="text" name="name" placeholder={ T(ctx, "settings.newCategory") } required/>
						<select class="input w-32 shrink-0" name="classification" aria-label={ T(ctx, "settings.kind") }>
							for _, o := range DirectionOptions(ctx) {
								<option value={ o.Value }>{ o.Label }</option>
							}
						</select>
						<input class="input h-11 w-14 shrink-0 p-1" type="color" name="color" value="#6366f1" aria-label={ T(ctx, "settings.color") }/>
						<button class="btn-primary shrink-0" type="submit">{ T(ctx, "action.add") }</button>
					</form>
					@categorySuggestions(vm)
				</div>
			</div>
			<div class="card-tight lg:col-span-2" id="tags">
				<div class="card-head"><h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "settings.tags") }</h2></div>
				<div class="card-body">
					<div id="tag-list" class="flex flex-wrap items-center gap-2">
						for _, t := range vm.Tags {
							@TagRowView(t)
						}
					</div>
					<form
						class="mt-3 flex flex-wrap gap-2"
						hx-post="/tags"
						hx-target="#tag-list"
						hx-swap="beforeend"
						data-reset-on-success
					>
						<input class="input min-w-0 flex-1" type="text" name="name" placeholder={ T(ctx, "settings.newTag") } required/>
						<input class="input h-11 w-14 shrink-0 p-1" type="color" name="color" value="#14b8a6" aria-label={ T(ctx, "settings.color") }/>
						<button class="btn-primary shrink-0" type="submit">{ T(ctx, "action.add") }</button>
					</form>
				</div>
			</div>
			if vm.Carry.Pending() {
				@carryCard(vm.Carry)
			}
			@dataCard()
		</div>
	}
}

// carryCard is the yearly review. Every recurring booking runs to the end of
// its year on purpose, so the new year is a decision per booking rather than
// something that happens while nobody is looking.
templ carryCard(vm CarryVM) {
	<div class="card-tight lg:col-span-2" id="carry">
		<div class="card-head">
			<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "settings.carry") }</h2>
			<span class="badge ml-auto">{ vm.YearStr() }</span>
		</div>
		<div class="card-body">
			<p class="mb-3 text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "settings.carryHint") }</p>
			<form hx-post="/settings/carry-forward" hx-swap="none">
				<input type="hidden" name="year" value={ vm.YearStr() }/>
				<div class="grid gap-1">
					for _, row := range vm.Rows {
						<label class="carry-row">
							<input type="checkbox" name="booking" value={ strconv.FormatInt(row.Booking.ID, 10) } checked/>
							<span class="min-w-0 flex-1 truncate text-sm text-slate-800 dark:text-slate-200">
								{ row.Booking.Name }
								<span class="text-slate-400 dark:text-slate-500">· { row.Category.Name }</span>
							</span>
							<span class="date-chip">{ Tf(ctx, "settings.carryUntil", FormatDate(row.Booking.EndsOn)) }</span>
							<span class="tnum shrink-0 text-sm font-medium text-slate-700 dark:text-slate-300">{ FormatEUR(row.Booking.AmountCents) }</span>
						</label>
					}
				</div>
				<button class="btn-primary mt-3" type="submit">{ Tf(ctx, "settings.carryApply", vm.YearStr()) }</button>
			</form>
		</div>
	</div>
}

// dataCard is where the whole book is carried out of the app and back in, and
// where it is thrown away. A reset is final, so the backup sits next to it.
templ dataCard() {
	<div class="card-tight lg:col-span-2" id="data">
		<div class="card-head"><h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "settings.data") }</h2></div>
		<div class="card-body grid gap-5 sm:grid-cols-2">
			<div>
				<span class="field-label">{ T(ctx, "settings.backup") }</span>
				<p class="mb-2 text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "settings.backupHint") }</p>
				<a class="btn-primary inline-block" href="/settings/backup.json" download>{ T(ctx, "settings.backupDownload") }</a>
			</div>
			<div>
				<span class="field-label">{ T(ctx, "settings.restore") }</span>
				<p class="mb-2 text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "settings.restoreHint") }</p>
				<form
					class="flex flex-wrap items-center gap-2"
					hx-post="/settings/restore"
					hx-encoding="multipart/form-data"
					hx-swap="none"
					hx-confirm={ T(ctx, "settings.restoreConfirm") }
				>
					<input class="input min-w-0 flex-1" type="file" name="snapshot" accept="application/json,.json" required/>
					<button class="btn-ghost shrink-0" type="submit">{ T(ctx, "settings.restoreUpload") }</button>
				</form>
			</div>
			<div class="danger-zone sm:col-span-2">
				<span class="field-label">{ T(ctx, "settings.startOver") }</span>
				<p class="mb-3 text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "settings.startOverHint") }</p>
				<div class="flex flex-wrap gap-2">
					<button
						class="btn-ghost"
						type="button"
						hx-post="/settings/reset-bookings"
						hx-swap="none"
						hx-confirm={ T(ctx, "settings.resetBookingsConfirm") }
					>{ T(ctx, "settings.resetBookings") }</button>
					<button
						class="btn-danger"
						type="button"
						hx-post="/settings/reset"
						hx-swap="none"
						hx-confirm={ T(ctx, "settings.resetAllConfirm") }
					>{ T(ctx, "settings.resetAll") }</button>
				</div>
			</div>
		</div>
	</div>
}

// categorySuggestions offers what a household usually books but has not created
// yet, so the list can be filled in without inventing names.
templ categorySuggestions(vm SettingsVM) {
	<div class="mt-5 border-t border-slate-200 pt-4 dark:border-slate-800">
		<span class="field-label">{ T(ctx, "settings.suggestions") }</span>
		if len(vm.Suggestions) == 0 {
			<p class="text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "settings.allSuggestions") }</p>
		} else {
			<p class="mb-2 text-xs text-slate-500 dark:text-slate-400">{ T(ctx, "settings.suggestionsHint") }</p>
			<div class="flex flex-wrap gap-2">
				for _, s := range vm.Suggestions {
					<button
						type="button"
						class="suggest-chip"
						hx-post="/categories/suggest"
						hx-vals={ `{"name":` + jsonString(s.Name) + `}` }
						hx-swap="none"
					>
						<span class="cat-icon cat-icon-sm" style={ "color:" + ColorOr(s.Color) }>
							@iconSVG(s.Icon)
						</span>
						{ s.Name }
						<span aria-hidden="true">+</span>
					</button>
				}
			</div>
		}
	</div>
}

templ HouseholdRowView(h store.Household, activeID int64) {
	<div id={ "hh-" + strconv.FormatInt(h.ID, 10) } class="flex items-center gap-2 border-b border-slate-200/70 pb-2 last:border-0 last:pb-0 dark:border-slate-800/60">
		<form
			class="min-w-0 flex-1"
			hx-post={ "/households/" + strconv.FormatInt(h.ID, 10) }
			hx-trigger="change, keyup changed delay:600ms"
			hx-swap="none"
		>
			<input class="input" type="text" name="name" value={ h.Name } required/>
		</form>
		if h.ID == activeID {
			<span class="badge badge-ok shrink-0">{ T(ctx, "settings.active") }</span>
		} else {
			<button
				class="btn-ghost shrink-0"
				hx-post={ "/households/activate?id=" + strconv.FormatInt(h.ID, 10) }
				hx-swap="none"
			>{ T(ctx, "settings.activate") }</button>
		}
		@moveButtons("/households/" + strconv.FormatInt(h.ID, 10))
		<button
			class="btn-icon shrink-0 no-print"
			hx-post={ "/households/" + strconv.FormatInt(h.ID, 10) + "/delete" }
			hx-swap="none"
			hx-confirm={ T(ctx, "settings.confirmHousehold") }
			aria-label={ T(ctx, "action.delete") }
		>✕</button>
	</div>
}

templ MemberRowView(m store.Member) {
	<div id={ "mem-" + strconv.FormatInt(m.ID, 10) } class="flex items-center gap-2 border-b border-slate-200/70 pb-2 last:border-0 last:pb-0 dark:border-slate-800/60">
		<form
			class="flex min-w-0 flex-1 items-center gap-2"
			hx-post={ "/members/" + strconv.FormatInt(m.ID, 10) }
			hx-trigger="change, keyup changed delay:600ms"
			hx-swap="none"
		>
			<input class="h-9 w-10 shrink-0 cursor-pointer rounded-md border border-slate-300 bg-transparent p-0.5 dark:border-slate-700" type="color" name="color" value={ ColorOr(m.Color) } aria-label={ T(ctx, "settings.color") }/>
			// A person without a name cannot be told apart in a split.
			<input class="input" type="text" name="name" value={ m.Name } aria-label={ T(ctx, "settings.name") } required/>
		</form>
		@moveButtons("/members/" + strconv.FormatInt(m.ID, 10))
		<button
			class="btn-icon shrink-0 no-print"
			hx-post={ "/members/" + strconv.FormatInt(m.ID, 10) + "/delete" }
			hx-target={ "#mem-" + strconv.FormatInt(m.ID, 10) }
			hx-swap="outerHTML"
			hx-confirm={ T(ctx, "settings.confirmMember") }
			aria-label={ T(ctx, "action.delete") }
		>✕</button>
	</div>
}

templ CategoryRowView(c store.Category, usage int, icons []string) {
	<div id={ "cat-" + strconv.FormatInt(c.ID, 10) } class="flex items-center gap-2 border-b border-slate-200/70 pb-2 last:border-0 last:pb-0 dark:border-slate-800/60">
		<form
			class="flex min-w-0 flex-1 flex-wrap items-center gap-2"
			hx-post={ "/categories/" + strconv.FormatInt(c.ID, 10) }
			hx-trigger="change, keyup changed delay:600ms"
			hx-swap="none"
		>
			@categoryIcon(c)
			<select class="input w-32 shrink-0" name="icon" aria-label={ T(ctx, "settings.icon") }>
				for _, key := range icons {
					<option value={ key } selected?={ key == IconOr(c) }>{ key }</option>
				}
			</select>
			<input class="input h-11 w-12 shrink-0 p-1" type="color" name="color" value={ ColorOr(c.Color) } aria-label={ T(ctx, "settings.color") }/>
			<input class="input min-w-0 flex-1" type="text" name="name" value={ c.Name } required/>
			<select class="input w-32 shrink-0" name="classification" aria-label={ T(ctx, "settings.kind") }>
				for _, o := range DirectionOptions(ctx) {
					<option value={ o.Value } selected?={ o.Value == string(c.Classification) }>{ o.Label }</option>
				}
			</select>
		</form>
		if usage > 0 {
			<span class="badge shrink-0">{ Tf(ctx, "settings.usedBy", usage) }</span>
		}
		<button
			class="btn-icon shrink-0 no-print"
			hx-post={ "/categories/" + strconv.FormatInt(c.ID, 10) + "/delete" }
			hx-swap="none"
			hx-confirm={ T(ctx, "settings.confirmCategory") }
			aria-label={ T(ctx, "action.delete") }
		>✕</button>
	</div>
}

// TagRowView renders a tag the way it appears everywhere else: as a label in
// its own colour, editable in place.
templ TagRowView(t store.Tag) {
	<span id={ "tag-" + strconv.FormatInt(t.ID, 10) } class="tag-chip" style={ tagStyle(t.Color) }>
		<form
			class="flex items-center gap-1.5"
			hx-post={ "/tags/" + strconv.FormatInt(t.ID, 10) }
			hx-trigger="change, keyup changed delay:600ms"
			hx-swap="none"
		>
			<input class="tag-color" type="color" name="color" value={ ColorOr(t.Color) } aria-label={ T(ctx, "settings.color") }/>
			<input class="tag-name" type="text" name="name" value={ t.Name } size="10" aria-label={ T(ctx, "settings.name") } required/>
		</form>
		<button
			type="button"
			class="tag-remove no-print"
			hx-post={ "/tags/" + strconv.FormatInt(t.ID, 10) + "/delete" }
			hx-target={ "#tag-" + strconv.FormatInt(t.ID, 10) }
			hx-swap="outerHTML"
			hx-confirm={ T(ctx, "settings.confirmTag") }
			aria-label={ T(ctx, "action.delete") }
		>✕</button>
	</span>
}
