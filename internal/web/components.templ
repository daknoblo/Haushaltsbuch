package web

import "github.com/daknoblo/Haushaltsbuch/internal/store"

templ money(cents int64) {
	<span class="tnum">{ FormatEUR(cents) }</span>
}

templ signedMoney(cents int64) {
	if cents < 0 {
		<span class="tnum font-medium text-rose-600 dark:text-rose-400">{ FormatEUR(cents) }</span>
	} else {
		<span class="tnum font-medium text-emerald-600 dark:text-emerald-400">{ FormatEUR(cents) }</span>
	}
}

templ costBadge(c store.CostNature) {
	if c == store.CostVariable {
		<span class="badge badge-warn">{ T(ctx, "cost.variable") }</span>
	} else {
		<span class="badge badge-info">{ T(ctx, "cost.fix") }</span>
	}
}

templ classBadge(b store.BudgetClass) {
	switch b {
		case store.ClassWant:
			<span class="badge badge-warn">{ T(ctx, "class.want") }</span>
		case store.ClassSaving:
			<span class="badge badge-ok">{ T(ctx, "class.saving") }</span>
		default:
			<span class="badge badge-muted">{ T(ctx, "class.need") }</span>
	}
}

templ memberDot(color string) {
	<span class="dot" style={ "background-color:" + ColorOr(color) }></span>
}

templ hbar(label string, cents, max int64) {
	<div class="grid grid-cols-[minmax(0,9rem)_1fr_auto] items-center gap-3 py-1.5">
		<div class="truncate text-sm text-slate-600 dark:text-slate-400">{ label }</div>
		<div class="bar-track">
			<div class="bar-fill" style={ "width:" + BarWidth(cents, max) }></div>
		</div>
		<div class="tnum text-right text-sm text-slate-700 dark:text-slate-300">{ FormatEUR(cents) }</div>
	</div>
}

// noHousehold is shown when no household is selected yet.
templ noHousehold() {
	<div class="card text-center">
		<p class="text-slate-600 dark:text-slate-400">{ T(ctx, "empty.noHousehold") }</p>
		<a href="/settings#haushalte" class="btn-primary mt-4">{ T(ctx, "empty.createHousehold") }</a>
	</div>
}
