package web

import "github.com/daknoblo/Haushaltsbuch/internal/store"

templ StatisticsPage(nav Nav, vm StatisticsVM) {
	@Layout(nav) {
		@pageHeading(T(ctx, "stats.title"), Tf(ctx, "stats.period", nav.CurrentMonthLabel())) {
			<a class="btn-ghost ml-auto no-print" href={ templ.SafeURL("/export/statistics.pdf?m=" + nav.Month) }>{ T(ctx, "action.exportPDF") }</a>
		}
		if nav.ActiveHousehold.ID == 0 {
			@noHousehold()
		} else {
			<div class="grid gap-4 sm:grid-cols-3">
				@statTile(T(ctx, "stats.avgIncome"), FormatEUR(vm.AvgIncome), T(ctx, "stats.perDataMonth"), "text-emerald-600 dark:text-emerald-400")
				@statTile(T(ctx, "stats.avgExpenses"), FormatEUR(vm.AvgExpense), T(ctx, "stats.perDataMonth"), "text-rose-600 dark:text-rose-400")
				@statTile(T(ctx, "stats.avgBalance"), FormatEUR(vm.AvgIncome-vm.AvgExpense), T(ctx, "stats.perMonth"), balanceTone(vm.AvgIncome-vm.AvgExpense))
			</div>
			<div class="card mt-4">
				<div class="mb-4 flex flex-wrap items-center gap-2">
					<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "stats.chartTitle") }</h2>
					<span class="badge ml-auto"><span class="dot bg-emerald-500"></span> { T(ctx, "overview.income") }</span>
					<span class="badge"><span class="dot bg-rose-500"></span> { T(ctx, "overview.expenses") }</span>
				</div>
				if len(vm.Months) == 0 {
					<p class="alert-info">{ T(ctx, "stats.noData") }</p>
				} else {
					<div class="flex h-56 items-end gap-2">
						for _, m := range vm.Months {
							<div class="flex h-full min-w-0 flex-1 flex-col justify-end gap-2">
								<div class="flex h-full items-end justify-center gap-1">
									<div class="vbar-income w-3" style={ "height:" + BarWidth(m.IncomeCents, vm.MaxCents) } title={ T(ctx, "overview.income") + " " + FormatEUR(m.IncomeCents) }></div>
									<div class="vbar-expense w-3" style={ "height:" + BarWidth(m.ExpenseCents, vm.MaxCents) } title={ T(ctx, "overview.expenses") + " " + FormatEUR(m.ExpenseCents) }></div>
								</div>
								<div class="truncate text-center text-[11px] text-slate-500 dark:text-slate-400">{ m.Label() }</div>
							</div>
						}
					</div>
				}
			</div>
			<div class="mt-4 grid gap-4 lg:grid-cols-3">
				<div class="card">
					<h3 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "overview.costNature") } ({ MonthLabel(vm.Current.Month) })</h3>
					@breakdownRow(T(ctx, "cost.fix"), "badge-info", vm.Current.ByCostNature[store.CostFix])
					@breakdownRow(T(ctx, "cost.variable"), "badge-warn", vm.Current.ByCostNature[store.CostVariable])
				</div>
				<div class="card">
					<h3 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "stats.rule503020") }</h3>
					@breakdownRow(T(ctx, "class.need"), "badge-muted", vm.Current.ByBudgetClass[store.ClassNeed])
					@breakdownRow(T(ctx, "class.want"), "badge-warn", vm.Current.ByBudgetClass[store.ClassWant])
					@breakdownRow(T(ctx, "class.saving"), "badge-ok", vm.Current.ByBudgetClass[store.ClassSaving])
				</div>
				<div class="card">
					<h3 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "stats.topCategories") }</h3>
					if len(vm.Current.Categories) == 0 {
						<p class="alert-info">{ T(ctx, "stats.noCategories") }</p>
					} else {
						for _, c := range vm.Current.Categories {
							@hbar(c.Label, c.Cents, MaxLabeled(vm.Current.Categories))
						}
					}
				</div>
			</div>
		}
	}
}
