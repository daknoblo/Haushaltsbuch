package web

import (
	"strconv"

	"github.com/daknoblo/Haushaltsbuch/internal/store"
)

templ IncomePage(nav Nav, vm IncomeVM) {
	@Layout(nav) {
		@pageHeading(T(ctx, "income.title"), T(ctx, "income.subtitle")) {
			<div class="ml-auto flex flex-wrap items-center gap-3 no-print">
				<div class="text-right">
					<div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">{ T(ctx, "income.total") }</div>
					<div class="tnum text-lg font-semibold text-slate-900 dark:text-slate-100">{ FormatEUR(vm.TotalCents) }</div>
				</div>
				<button
					class="btn-ghost"
					hx-post={ "/income/copy?from=" + nav.PrevMonth() + "&to=" + nav.Month }
					hx-swap="none"
					hx-confirm={ Tf(ctx, "income.confirmCopy", MonthLabel(nav.PrevMonth())) }
				>{ T(ctx, "income.copyPrevious") }</button>
			</div>
		}
		if nav.ActiveHousehold.ID == 0 {
			@noHousehold()
		} else {
			<div class="grid gap-4 lg:grid-cols-2">
				for _, mv := range vm.Members {
					@incomeMemberCard(nav, mv)
				}
			</div>
		}
	}
}

templ incomeMemberCard(nav Nav, mv IncomeMemberVM) {
	<div class="card-tight">
		<div class="card-head">
			<span class="flex items-center gap-2">
				@memberDot(mv.Member.Color)
				<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ mv.Member.Name }</h2>
			</span>
			<span class="tnum ml-auto text-sm font-semibold text-slate-700 dark:text-slate-300">{ FormatEUR(mv.TotalCents) }</span>
		</div>
		<div class="card-body">
			<div id={ "inclines-" + strconv.FormatInt(mv.Member.ID, 10) } class="grid gap-2">
				for _, in := range mv.Lines {
					@IncomeLineView(in)
				}
			</div>
			<button
				class="btn-ghost mt-3 no-print"
				hx-post={ "/income/new?member=" + strconv.FormatInt(mv.Member.ID, 10) + "&m=" + nav.Month }
				hx-target={ "#inclines-" + strconv.FormatInt(mv.Member.ID, 10) }
				hx-swap="beforeend"
			>{ T(ctx, "income.addLine") }</button>
		</div>
	</div>
}

templ IncomeLineView(in store.Income) {
	<form
		id={ "inc-" + strconv.FormatInt(in.ID, 10) }
		class="flex items-center gap-2"
		hx-post={ "/income/" + strconv.FormatInt(in.ID, 10) }
		hx-trigger="change, keyup changed delay:700ms"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<input class="input flex-1" type="text" name="name" value={ in.Name } placeholder={ T(ctx, "income.namePlaceholder") } aria-label={ T(ctx, "income.name") }/>
		<input class="input tnum w-32 shrink-0" type="number" step="0.01" name="amount" value={ CentsToInput(in.AmountCents) } aria-label={ T(ctx, "income.amount") }/>
		<button
			type="button"
			class="btn-icon shrink-0 no-print"
			hx-post={ "/income/" + strconv.FormatInt(in.ID, 10) + "/delete" }
			hx-target={ "#inc-" + strconv.FormatInt(in.ID, 10) }
			hx-swap="outerHTML"
			aria-label={ T(ctx, "income.deleteLine") }
		>✕</button>
	</form>
}
