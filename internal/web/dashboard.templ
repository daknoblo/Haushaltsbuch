package web

import (
	"strconv"

	"github.com/daknoblo/Haushaltsbuch/internal/calc"
	"github.com/daknoblo/Haushaltsbuch/internal/store"
)

templ DashboardPage(nav Nav, vm DashboardVM) {
	@Layout(nav) {
		@pageHeading(T(ctx, "dash.title"), T(ctx, "dash.subtitle")) {
			<div class="ml-auto flex flex-wrap items-center gap-2 no-print">
				<a class="btn-ghost" href={ templ.SafeURL("/export/overview.pdf?m=" + nav.Month) }>{ T(ctx, "pdf.overview") }</a>
				<a class="btn-ghost" href={ templ.SafeURL("/export/expenses.pdf?m=" + nav.Month) }>{ T(ctx, "pdf.expenseList") }</a>
				<a class="btn-ghost" href={ templ.SafeURL(vm.YearExportURL(nav.Month)) }>{ T(ctx, "pdf.year") }</a>
				<a class="btn-primary" href={ templ.SafeURL("/export/statistics.pdf?m=" + nav.Month) }>{ T(ctx, "action.exportPDF") }</a>
			</div>
		}
		if nav.ActiveHousehold.ID == 0 {
			@noHousehold()
		} else {
			<div class="grid gap-4">
				@viewSwitch(vm)
				@chartCard(vm)
				@headlineTiles(vm)
				@matrixCard(vm)
				@stackCard(vm)
				if vm.ShowSettlement() {
					@settlementCard(vm)
					@shareCard(vm)
				}
				<div class="grid gap-4 lg:grid-cols-2">
					@fixedCostCard(vm)
					@savingsCard(vm)
				</div>
				@ruleCard(vm)
				@sankeyCard(vm)
				@categoryCard(vm)
				@tagCard(vm)
			</div>
		}
	}
}

// viewSwitch flips every card between the whole household and a single person
// and carries the one period control. It sticks to the top because the page is
// long enough that a reader deep in the flow diagram would otherwise have to
// scroll back up to ask the same question about a different month.
templ viewSwitch(vm DashboardVM) {
	<div class="view-bar no-print">
		<div class="flex flex-wrap items-center gap-2 px-4 py-2.5">
			<span class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">{ T(ctx, "dash.view") }</span>
			for _, v := range vm.Views {
				if v.Active {
					<span class="btn-primary pointer-events-none">
						if v.Member != 0 {
							@memberDot(v.Color)
						}
						{ v.Label }
					</span>
				} else {
					<a class="btn-ghost" href={ templ.SafeURL(v.URL) }>
						if v.Member != 0 {
							@memberDot(v.Color)
						}
						{ v.Label }
					</a>
				}
			}
			<div class="ml-auto flex items-center gap-1">
				<a class="btn-icon" href={ templ.SafeURL(vm.PrevURL) } aria-label={ T(ctx, "dash.rangePrev") }>‹</a>
				<label class="section-picker">
					<select data-nav="1" aria-label={ T(ctx, "dash.range") }>
						for _, p := range vm.Periods {
							<option value={ p.URL } selected?={ p.Active }>{ p.Label }</option>
						}
					</select>
				</label>
				<a class="btn-icon" href={ templ.SafeURL(vm.NextURL) } aria-label={ T(ctx, "dash.rangeNext") }>›</a>
			</div>
		</div>
	</div>
}

// chartCard names the span it draws, now that the control moved to the bar.
templ chartCard(vm DashboardVM) {
	<div class="card">
		<div class="mb-4 text-center text-sm font-medium text-slate-700 dark:text-slate-300">{ vm.RangeLabel }</div>
		if vm.Chart.Empty() {
			<p class="text-center text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "dash.noData") }</p>
		} else {
			@trendChart(vm.Chart)
			<div class="mt-3 flex flex-wrap items-center justify-center gap-4 text-xs text-slate-500 dark:text-slate-400">
				<span class="flex items-center gap-1.5"><span class="dot bg-emerald-500"></span>{ T(ctx, "overview.income") }</span>
				<span class="flex items-center gap-1.5"><span class="dot bg-indigo-500"></span>{ T(ctx, "overview.expenses") }</span>
				<span class="flex items-center gap-1.5"><span class="dot bg-slate-500"></span>{ T(ctx, "dash.surplus") }</span>
			</div>
		}
	</div>
}

// trendChart is laid out in Go, because the CSP grants no 'unsafe-eval' and a
// charting library would be a large dependency for one picture.
templ trendChart(c calc.TrendChart) {
	<svg class="h-auto w-full" viewBox={ ChartViewBox(c) } role="img" aria-label={ T(ctx, "dash.chartTitle") }>
		<g class="chart-grid">
			for _, g := range c.Grid {
				<line x1={ Coord(c.Left) } y1={ Coord(g.Y) } x2={ Coord(c.Right) } y2={ Coord(g.Y) }></line>
				<text class="chart-label" x={ Coord(c.Left - 8) } y={ Coord(g.Y) } text-anchor="end" dominant-baseline="middle">
					{ FormatCents(g.Cents) }
				</text>
			}
		</g>
		<g>
			for _, b := range c.Bars {
				<rect
					class={ templ.KV("chart-bar-income", b.Income), templ.KV("chart-bar-expense", !b.Income) }
					x={ Coord(b.X) }
					y={ Coord(b.Y) }
					width={ Coord(b.Width) }
					height={ Coord(b.Height) }
					rx="2"
				>
					<title>{ MonthShort(ctx, b.Month) + ": " + FormatEUR(b.Cents) }</title>
				</rect>
			}
		</g>
		<g>
			<line class="chart-zero" x1={ Coord(c.Left) } y1={ Coord(c.Zero) } x2={ Coord(c.Right) } y2={ Coord(c.Zero) }></line>
			<polyline class="chart-line" points={ ChartLinePoints(c) }></polyline>
			for _, p := range c.Line {
				<circle class="chart-dot" cx={ Coord(p.X) } cy={ Coord(p.Y) } r="3"></circle>
				<text class="chart-value" x={ Coord(p.X) } y={ Coord(ChartLabelY(p)) } text-anchor="middle">
					{ FormatEURShort(p.Cents) }
				</text>
			}
		</g>
		<g>
			for _, t := range c.Ticks {
				<text class="chart-label" x={ Coord(t.X) } y={ Coord(c.Bottom + 15) } text-anchor="middle">
					{ MonthShort(ctx, t.Month) }
				</text>
			}
		</g>
	</svg>
}

// matrixCard is the year at a glance: what every category cost in every month,
// with its bookings a click away. The other cards answer what a household
// spends; this one answers when.
templ matrixCard(vm DashboardVM) {
	<div class="card">
		<div class="card-head">
			<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "matrix.title") }</h2>
			<span class="badge ml-auto">{ vm.MatrixYear }</span>
		</div>
		<p class="mb-3 text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "matrix.hint") }</p>
		if vm.Matrix.Empty() {
			<p class="text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "dash.noData") }</p>
		} else {
			<div class="matrix-scroll">
				<table class="matrix">
					<thead>
						<tr>
							<th class="matrix-head matrix-sticky text-left">{ T(ctx, "matrix.row") }</th>
							for _, m := range vm.Matrix.Months {
								<th class="matrix-head text-right">{ MonthShort(ctx, m) }</th>
							}
							<th class="matrix-head text-right">{ T(ctx, "matrix.total") }</th>
							<th class="matrix-head matrix-aside">{ T(ctx, "matrix.mean") }</th>
							<th class="matrix-head matrix-aside">{ T(ctx, "matrix.median") }</th>
						</tr>
					</thead>
					for _, band := range vm.Matrix.Bands {
						@matrixBand(vm, band)
					}
					<tbody class="matrix-summary">
						@matrixLine(vm, vm.Matrix.Expense, "")
						@matrixLine(vm, vm.Matrix.Surplus, "matrix-surplus")
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ matrixBand(vm DashboardVM, band calc.MatrixBand) {
	<tbody class="matrix-band">
		<tr>
			<th class="matrix-band-head matrix-sticky text-left" colspan="1">{ MatrixBandLabel(ctx, band.Key) }</th>
			<td class="matrix-band-head" colspan={ MatrixSpan(vm.Matrix) }></td>
		</tr>
	</tbody>
	for _, row := range band.Rows {
		// One group per category, so a checkbox and :has() can fold its bookings
		// away. A <details> cannot wrap table rows.
		<tbody class="matrix-group">
			<tr class="matrix-line matrix-row">
				<th class="matrix-cell matrix-sticky text-left">
					if len(row.Children) > 0 {
						<label class="matrix-toggle">
							<input type="checkbox" class="sr-only"/>
							<span class="matrix-caret" aria-hidden="true">›</span>
							@matrixDot(row)
							@matrixLabel(row)
						</label>
					} else {
						@matrixDot(row)
						@matrixLabel(row)
					}
				</th>
				@matrixCells(row)
			</tr>
			if band.Key != calc.BandIncome {
				@matrixShare(row)
			}
			for _, child := range row.Children {
				<tr class="matrix-line matrix-child">
					<th class="matrix-cell matrix-sticky text-left">{ child.Label }</th>
					@matrixCells(child)
				</tr>
				if band.Key != calc.BandIncome {
					@matrixShare(child)
				}
			}
		</tbody>
	}
	<tbody>
		<tr class="matrix-line matrix-total">
			<th class="matrix-cell matrix-sticky text-left">@matrixLabel(band.Total)</th>
			@matrixCells(band.Total)
		</tr>
		if band.Key != calc.BandIncome {
			@matrixShare(band.Total)
		}
	</tbody>
}

// matrixShare is the percentage belonging to the row above it. It is a second
// line only because a cell cannot hold two numbers legibly; hovering either one
// lights up both.
templ matrixShare(row calc.MatrixRow) {
	<tr class="matrix-share">
		<th class="matrix-cell matrix-sticky text-left">{ MatrixShareLabel(ctx) }</th>
		for _, p := range row.Share {
			<td class="matrix-cell text-right">{ FormatPercent(p) }</td>
		}
		<td class="matrix-cell text-right">{ FormatPercent(row.ShareTotal) }</td>
		<td class="matrix-cell matrix-aside"></td>
		<td class="matrix-cell matrix-aside"></td>
	</tr>
}

templ matrixLine(vm DashboardVM, row calc.MatrixRow, extra string) {
	<tr class={ "matrix-line matrix-total", extra }>
		<th class="matrix-cell matrix-sticky text-left">@matrixLabel(row)</th>
		@matrixCells(row)
	</tr>
}

templ matrixCells(row calc.MatrixRow) {
	for i, c := range row.Cents {
		<td class="matrix-cell text-right">
			@matrixTrend(row.Trend[i], row.Gain)
			{ MatrixCell(c) }
		</td>
	}
	// A line that ran in a single month has no average and no typical month; the
	// two columns stay empty there rather than repeating the total three times.
	<td class="matrix-cell text-right font-medium">{ FormatEURShort(row.TotalCents) }</td>
	<td class="matrix-cell matrix-aside">{ MatrixAverage(row, row.MeanCents) }</td>
	<td class="matrix-cell matrix-aside">{ MatrixAverage(row, row.MedianCents) }</td>
}

// matrixTrend marks a month against the one before it. The arrow is the fact
// and the color the verdict, which is why they can disagree: a rising salary
// points up in green, a rising rent points up in red. Nothing is drawn where
// there is nothing to compare, because an arrow against a month the booking did
// not run in would invent a change.
templ matrixTrend(t calc.MatrixTrend, gain bool) {
	switch t {
		case calc.TrendUp:
			<span class={ "trend", TrendTone(t, gain) } title={ T(ctx, "matrix.trendUp") } aria-label={ T(ctx, "matrix.trendUp") }>↗</span>
		case calc.TrendDown:
			<span class={ "trend", TrendTone(t, gain) } title={ T(ctx, "matrix.trendDown") } aria-label={ T(ctx, "matrix.trendDown") }>↘</span>
		case calc.TrendFlat:
			<span class="trend trend-flat" title={ T(ctx, "matrix.trendFlat") } aria-label={ T(ctx, "matrix.trendFlat") }>–</span>
	}
}

templ matrixLabel(row calc.MatrixRow) {
	if row.LabelKey != "" {
		{ T(ctx, row.LabelKey) }
	} else {
		{ row.Label }
	}
}

templ matrixDot(row calc.MatrixRow) {
	if row.Color != "" {
		@memberDot(row.Color)
	}
}

// stackCard compares the months by height and reads them by color, grouped
// either by category or by the third of the 50/30/20 rule they land in.
templ stackCard(vm DashboardVM) {
	<div class="card">
		<div class="card-head">
			<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "dash.stackTitle") }</h2>
			<div class="ml-auto flex flex-wrap items-center gap-1 no-print">
				for _, g := range vm.Groupings {
					if g.Active {
						<span class="period-chip period-chip-active">{ g.Label }</span>
					} else {
						<a class="period-chip" href={ templ.SafeURL(g.URL) }>{ g.Label }</a>
					}
				}
			</div>
		</div>
		if vm.Stack.Empty() {
			<p class="text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "dash.noData") }</p>
		} else {
			@stackChart(vm.Stack)
			<div class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-slate-500 dark:text-slate-400">
				for _, k := range vm.Stack.Keys {
					<span class="flex items-center gap-1.5">
						@memberDot(k.Color)
						if k.LabelKey != "" {
							{ T(ctx, k.LabelKey) }
						} else {
							{ k.Label }
						}
					</span>
				}
			</div>
		}
	</div>
}

templ stackChart(c calc.StackChart) {
	<svg class="h-auto w-full" viewBox={ StackViewBox(c) } role="img" aria-label={ T(ctx, "dash.stackTitle") }>
		<g class="chart-grid">
			for _, g := range c.Grid {
				<line x1={ Coord(c.Left) } y1={ Coord(g.Y) } x2={ Coord(c.Right) } y2={ Coord(g.Y) }></line>
				<text class="chart-label" x={ Coord(c.Left - 8) } y={ Coord(g.Y) } text-anchor="end" dominant-baseline="middle">
					{ FormatCents(g.Cents) }
				</text>
			}
		</g>
		for _, col := range c.Columns {
			<g>
				for _, seg := range col.Segments {
					<rect x={ Coord(seg.X) } y={ Coord(seg.Y) } width={ Coord(seg.Width) } height={ Coord(seg.Height) } fill={ ColorOr(seg.Color) }>
						<title>{ StackSegmentTitle(ctx, col, seg) }</title>
					</rect>
					if seg.Labeled {
						<text class="chart-segment" x={ Coord(seg.X + seg.Width/2) } y={ Coord(seg.Y + seg.Height/2) } text-anchor="middle" dominant-baseline="middle">
							{ FormatEURShort(seg.Cents) }
						</text>
					}
				}
			</g>
		}
		<g>
			for _, t := range c.Ticks {
				<text class="chart-label" x={ Coord(t.X) } y={ Coord(c.Bottom + 15) } text-anchor="middle">
					{ MonthShort(ctx, t.Month) }
				</text>
			}
		</g>
	</svg>
}

// headlineTiles put the household's fixed costs next to the share the selected
// view carries of them, which is the difference a person view is opened for.
templ headlineTiles(vm DashboardVM) {
	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
		@statTile(T(ctx, "overview.income"), FormatEUR(vm.Report.IncomeCents), T(ctx, "dash.perMonth"), "text-emerald-600 dark:text-emerald-400")
		@statTile(T(ctx, "dash.fixedCosts"), FormatEUR(vm.HouseholdReport.FixedCents()), FormatPercent(vm.HouseholdReport.FixedCostRate())+" "+T(ctx, "dash.fixedShare"), "text-indigo-600 dark:text-indigo-400")
		@statTile(T(ctx, "dash.ownFixedCosts"), FormatEUR(vm.Report.FixedCents()), T(ctx, "dash.ownFixedHint"), "text-violet-600 dark:text-violet-400")
		@statTile(T(ctx, "dash.savingsRate"), FormatPercent(vm.Report.SavingsRate()), T(ctx, "dash.perMonth"), "text-sky-600 dark:text-sky-400")
	</div>
}

// settlementCard answers "who owes whom", which only the payer of a booking
// makes computable. The payment comes first; every member's own ledger is one
// click away, so the figure can be followed line by line.
templ settlementCard(vm DashboardVM) {
	<div class="card">
		<div class="card-head">
			<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "dash.settlement") }</h2>
			<span class="badge ml-auto">{ vm.RangeLabel }</span>
		</div>
		<p class="mb-3 text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "dash.settlementHint") }</p>
		if !vm.HouseholdView() {
			<p class="mb-3 text-xs text-slate-500 dark:text-slate-400">{ T(ctx, "dash.settlementScope") }</p>
		}
		if vm.SettlementEven() {
			<p class="alert-info">{ T(ctx, "dash.settlementEven") }</p>
		} else {
			<div class="grid gap-2">
				for _, tr := range vm.Transfers() {
					<div class="settle-result">
						@memberDot(tr.From.Color)
						<span class="font-semibold text-slate-900 dark:text-slate-100">{ tr.From.Name }</span>
						<span class="text-slate-500 dark:text-slate-400">{ T(ctx, "dash.transfersTo") }</span>
						@memberDot(tr.To.Color)
						<span class="font-semibold text-slate-900 dark:text-slate-100">{ tr.To.Name }</span>
						<span class="tnum ml-auto text-lg font-semibold text-slate-900 dark:text-slate-100">{ FormatEUR(tr.Cents) }</span>
					</div>
				}
			</div>
		}
		<p class="mb-2 mt-4 text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">{ T(ctx, "dash.ledgerTitle") }</p>
		<div class="grid gap-2">
			for _, p := range vm.Positions() {
				@memberLedger(p, vm.Ledger(p.Member.ID))
			}
		</div>
	</div>
}

// memberLedger is one person's side of the settlement: what they fronted, what
// they carry and what that leaves them with.
templ memberLedger(p calc.MemberPosition, lines []calc.LedgerLine) {
	<details class="settle">
		<summary class="settle-summary">
			<span class="settle-caret" aria-hidden="true">›</span>
			@memberDot(p.Member.Color)
			<span class="font-medium text-slate-900 dark:text-slate-100">{ p.Member.Name }</span>
			<span class="hidden gap-1.5 sm:flex">
				<span class="badge">{ T(ctx, "dash.paid") } { FormatEUR(p.PaidCents) }</span>
				<span class="badge">{ T(ctx, "dash.owed") } { FormatEUR(p.OwedCents) }</span>
			</span>
			<span class="ml-auto">
				@signedMoney(p.NetCents)
			</span>
		</summary>
		<div class="settle-body">
			<p class="text-xs text-slate-500 dark:text-slate-400">{ Tf(ctx, "dash.ledgerHint", p.Member.Name) }</p>
			<div class="overflow-x-auto">
				<table class="w-full">
					<thead>
						<tr>
							<th class="table-head">{ T(ctx, "dash.booking") }</th>
							<th class="table-head whitespace-nowrap text-right">{ T(ctx, "dash.paid") }</th>
							<th class="table-head whitespace-nowrap text-right">{ T(ctx, "dash.owed") }</th>
							<th class="table-head whitespace-nowrap text-right">{ T(ctx, "overview.balance") }</th>
						</tr>
					</thead>
					<tbody>
						for _, l := range lines {
							<tr>
								<td class="table-cell">
									if l.Booking.Name == "" {
										<span class="italic text-slate-400 dark:text-slate-500">{ T(ctx, "bookings.unnamed") }</span>
									} else {
										{ l.Booking.Name }
									}
								</td>
								<td class="table-cell tnum whitespace-nowrap text-right">
									if l.PaidCents == 0 {
										<span class="text-slate-400 dark:text-slate-600">–</span>
									} else {
										{ FormatEUR(l.PaidCents) }
									}
								</td>
								<td class="table-cell tnum whitespace-nowrap text-right">
									if l.OwedCents == 0 {
										<span class="text-slate-400 dark:text-slate-600">–</span>
									} else {
										{ FormatEUR(l.OwedCents) }
									}
								</td>
								<td class="table-cell whitespace-nowrap text-right">
									@signedMoney(l.NetCents)
								</td>
							</tr>
						}
						<tr>
							<td class="table-cell font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "dash.sum") }</td>
							<td class="table-cell tnum whitespace-nowrap text-right font-semibold">{ FormatEUR(p.PaidCents) }</td>
							<td class="table-cell tnum whitespace-nowrap text-right font-semibold">{ FormatEUR(p.OwedCents) }</td>
							<td class="table-cell whitespace-nowrap text-right">
								@signedMoney(p.NetCents)
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</details>
}

// shareCard is what makes the settlement checkable: it shows per booking who
// fronts it and whether it is divided at all, because a bill a single member
// carries alone moves no money between members.
templ shareCard(vm DashboardVM) {
	<div class="card">
		<div class="card-head">
			<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "dash.shares") }</h2>
			<span class="badge ml-auto">{ vm.RangeLabel }</span>
		</div>
		<p class="mb-3 text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "dash.sharesHint") }</p>
		<div class="mb-4 grid gap-3 sm:mx-auto sm:max-w-xl sm:grid-cols-2">
			@shareTotal(T(ctx, "dash.sharedTotal"), vm.Carried().SharedCents, "badge-info")
			@shareTotal(T(ctx, "dash.soleTotal"), vm.Carried().SoleCents, "badge-muted")
		</div>
		if len(vm.ShareLines()) == 0 {
			<p class="text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "dash.noData") }</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full">
					<thead>
						<tr>
							<th class="table-head">{ T(ctx, "dash.booking") }</th>
							<th class="table-head">{ T(ctx, "bookings.payer") }</th>
							<th class="table-head">{ T(ctx, "bookings.splitMode") }</th>
							<th class="table-head text-right whitespace-nowrap">{ T(ctx, "dash.perMonth") }</th>
							for _, p := range vm.Positions() {
								<th class="table-head text-right whitespace-nowrap">{ p.Member.Name }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, l := range vm.ShareLines() {
							<tr>
								<td class="table-cell font-medium text-slate-900 dark:text-slate-100">
									if l.Booking.Name == "" {
										<span class="italic text-slate-400 dark:text-slate-500">{ T(ctx, "bookings.unnamed") }</span>
									} else {
										{ l.Booking.Name }
									}
								</td>
								<td class="table-cell">
									<span class="flex items-center gap-2">
										@memberDot(l.Payer.Color)
										{ l.Payer.Name }
									</span>
								</td>
								<td class="table-cell">
									<span class={ "badge", templ.KV("badge-info", l.Shared()), templ.KV("badge-muted", !l.Shared()) }>
										{ SplitLabel(ctx, l) }
									</span>
								</td>
								<td class="table-cell tnum text-right whitespace-nowrap">{ FormatEUR(l.MonthlyCents) }</td>
								for _, p := range vm.Positions() {
									<td class="table-cell tnum text-right whitespace-nowrap">
										if l.ShareOf(p.Member.ID) == 0 {
											<span class="text-slate-400 dark:text-slate-600">–</span>
										} else {
											{ FormatEUR(l.ShareOf(p.Member.ID)) }
										}
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

templ shareTotal(label string, cents int64, badge string) {
	<div class="rounded-lg border border-slate-200 px-4 py-3 text-center dark:border-slate-800">
		<span class={ "badge", badge }>{ label }</span>
		<div class="tnum mt-1 text-lg font-semibold text-slate-900 dark:text-slate-100">
			{ FormatEUR(cents) } <span class="text-sm font-normal text-slate-400 dark:text-slate-500">{ T(ctx, "bookings.perMonth") }</span>
		</div>
	</div>
}

templ fixedCostCard(vm DashboardVM) {
	<div class="card">
		<div class="card-head">
			<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "dash.fixedCosts") }</h2>
			<span class="badge badge-info ml-auto">{ FormatPercent(vm.Report.FixedCostRate()) }</span>
		</div>
		<p class="mb-3 text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "dash.fixedHint") }</p>
		<div class="mb-4 flex items-baseline gap-3">
			<span class="tnum text-2xl font-semibold text-slate-900 dark:text-slate-100">{ FormatEUR(vm.Report.FixedCents()) }</span>
			<span class="text-sm text-slate-500 dark:text-slate-400">
				{ T(ctx, "dash.variableCosts") }: { FormatEUR(vm.Report.VariableCents()) }
			</span>
		</div>
		if len(vm.FixedTop) == 0 {
			<p class="text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "dash.noCategories") }</p>
		} else {
			for _, it := range vm.FixedTop {
				@hbar(it.Label, it.Cents, MaxLabeled(vm.FixedTop))
			}
		}
	</div>
}

templ savingsCard(vm DashboardVM) {
	<div class="card">
		<div class="card-head">
			<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "dash.savingsRate") }</h2>
			<span class="badge badge-ok ml-auto">{ FormatPercent(vm.Report.SavingsRate()) }</span>
		</div>
		<p class="mb-3 text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "dash.savingsHint") }</p>
		<div class="grid grid-cols-2 gap-3">
			<div>
				<div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">{ T(ctx, "dash.deliberate") }</div>
				<div class="tnum mt-1 text-lg font-semibold text-sky-600 dark:text-sky-400">{ FormatEUR(vm.Report.SavingCents()) }</div>
			</div>
			<div>
				<div class="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">{ T(ctx, "dash.surplus") }</div>
				<div class="tnum mt-1 text-lg font-semibold">
					@signedMoney(vm.Report.BalanceCents)
				</div>
			</div>
		</div>
	</div>
}

// ruleCard is the 50/30/20 rule as a picture: the ring is how income was really
// divided, the two marks on its edge are where the rule wanted the boundaries.
// The distance between an arc's end and its mark is the whole point.
templ ruleCard(vm DashboardVM) {
	<div class="card">
		<div class="card-head">
			<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "dash.rule503020") }</h2>
			if vm.ViewName() != "" {
				<span class="badge ml-auto">{ vm.ViewName() }</span>
			}
		</div>
		<p class="mb-4 text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "dash.ruleHint") }</p>
		if vm.Rule.Empty() {
			<p class="text-sm text-slate-400 dark:text-slate-500">{ T(ctx, "dash.ruleNoIncome") }</p>
		} else {
			<div class="rule-layout">
				@ruleRing(vm)
				<div class="grid gap-2.5">
					@ruleBucket(vm, store.ClassNeed, "bg-indigo-500", "border-indigo-500")
					@ruleBucket(vm, store.ClassWant, "bg-amber-500", "border-amber-500")
					@ruleBucket(vm, store.ClassSaving, "bg-sky-500", "border-sky-500")
					if vm.Rule.Surplus > 0 {
						<p class="text-xs text-slate-400 dark:text-slate-500">
							{ Tf(ctx, "dash.ruleSurplus", FormatEUR(vm.Rule.Surplus)) }
						</p>
					}
					if vm.Report.OverIncomeCents() > 0 {
						<p class="text-xs font-medium text-rose-600 dark:text-rose-400">
							{ Tf(ctx, "dash.overIncome", FormatEUR(vm.Report.OverIncomeCents())) }
						</p>
					}
				</div>
			</div>
		}
	</div>
}

templ ruleRing(vm DashboardVM) {
	<div class="rule-ring">
		<svg viewBox={ RuleViewBox(vm.Rule) } class="h-auto w-full" role="img" aria-label={ T(ctx, "dash.rule503020") }>
			for _, a := range vm.Rule.Arcs {
				<path d={ a.Path } class={ RuleFill(a.Class) }>
					<title>{ RuleArcTitle(ctx, a) }</title>
				</path>
			}
			for _, m := range vm.Rule.Marks {
				<path d={ m.Path } class="stroke-slate-400 dark:stroke-slate-500" stroke-width="1.5" stroke-dasharray="3 2"></path>
				<text
					x={ Coord(m.LabelX) }
					y={ Coord(m.LabelY) }
					text-anchor="middle"
					dominant-baseline="middle"
					class="fill-slate-400 text-[10px] dark:fill-slate-500"
				>{ strconv.Itoa(m.Percent) + " %" }</text>
			}
		</svg>
		<div class="rule-center">
			<div class="text-[0.65rem] uppercase tracking-wide text-slate-400 dark:text-slate-500">{ T(ctx, "dash.income") }</div>
			<div class="tnum text-lg font-semibold text-slate-900 dark:text-slate-100">{ FormatEUR(vm.Report.IncomeCents) }</div>
		</div>
	</div>
}

// ruleBucket is one of the three pails of the rule, read against its target.
templ ruleBucket(vm DashboardVM, class store.BudgetClass, dot, edge string) {
	<div class={ "rule-bucket", edge }>
		<div class="flex items-baseline gap-2">
			<span class={ "inline-block h-2.5 w-2.5 shrink-0 rounded-full", dot }></span>
			<span class="text-sm font-medium text-slate-800 dark:text-slate-200">{ BudgetClassLabel(ctx, class) }</span>
			<span class="tnum ml-auto text-sm font-semibold text-slate-900 dark:text-slate-100">
				{ SharePercent(vm.Report.ByBudgetClass[class], vm.Report.IncomeCents) }
			</span>
		</div>
		<p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{ RuleBucketHint(ctx, class) }</p>
		<div class="tnum mt-1.5 flex items-baseline gap-1.5 text-xs">
			<span class="font-medium text-slate-700 dark:text-slate-300">{ FormatEUR(vm.Report.ByBudgetClass[class]) }</span>
			<span class="text-slate-400 dark:text-slate-500">
				{ TargetLabel(ctx, class.TargetPercent()) } · { FormatEUR(vm.Report.TargetCents(class)) }
			</span>
			<span class={ "ml-auto font-medium", RuleGapTone(vm.Report, class) }>{ RuleGapLabel(ctx, vm.Report, class) }</span>
		</div>
	</div>
}


templ sankeyCard(vm DashboardVM) {
	<div class="card">
		<div class="card-head">
			<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "dash.flow") }</h2>
			<span class="badge ml-auto">{ vm.RangeLabel }</span>
		</div>
		<p class="mb-3 text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "dash.flowHint") }</p>
		if vm.Sankey.Empty() {
			<p class="text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "dash.noData") }</p>
		} else {
			if vm.Sankey.Deficit {
				<p class="mb-3 text-sm text-rose-600 dark:text-rose-400">{ T(ctx, "dash.flowDeficit") }</p>
			}
			<div class="overflow-x-auto">
				@sankeySVG(vm.Sankey)
			</div>
		}
	</div>
}

templ sankeySVG(s calc.Sankey) {
	<svg
		class="h-auto w-full min-w-[42rem]"
		viewBox={ SankeyViewBox(s) }
		role="img"
		aria-label={ T(ctx, "dash.flow") }
	>
		<g>
			for _, l := range s.Links {
				<path d={ l.Path } fill={ l.Color } fill-opacity="0.28">
					<title>{ l.Label + ": " + FormatEUR(l.Cents) }</title>
				</path>
			}
		</g>
		<g>
			for _, n := range s.Nodes {
				<rect
					x={ Coord(n.X) }
					y={ Coord(n.Y) }
					width={ Coord(n.Width) }
					height={ Coord(n.Height) }
					rx="3"
					fill={ n.Color }
				>
					<title>{ n.Label + ": " + FormatEUR(n.Cents) }</title>
				</rect>
				<text
					x={ Coord(n.LabelX()) }
					y={ Coord(n.LabelY()) }
					text-anchor="start"
					dominant-baseline="middle"
					class="fill-slate-600 stroke-white stroke-[3px] text-[11px] [paint-order:stroke] dark:fill-slate-300 dark:stroke-slate-900"
				>{ n.Label }<tspan dx="6" class="fill-slate-400 text-[10px] dark:fill-slate-500">{ SankeyValue(s, n) }</tspan></text>
			}
		</g>
	</svg>
}

templ categoryCard(vm DashboardVM) {
	<div class="card">
		<div class="card-head">
			<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "dash.topCategories") }</h2>
			<span class="badge ml-auto">{ vm.RangeLabel }</span>
		</div>
		if len(vm.Report.Categories) == 0 {
			<p class="text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "dash.noCategories") }</p>
		} else {
			for _, c := range vm.Report.Categories {
				@categoryBar(c, MaxLabeled(vm.Report.Categories), vm.Report.ExpenseCents)
			}
		}
	</div>
}

// categoryBar shows the category's own symbol and colour plus its share, so
// "how much does food cost" is answerable at a glance.
templ categoryBar(c calc.LabeledTotal, max, total int64) {
	<div class="grid grid-cols-[minmax(0,10rem)_1fr_auto_auto] items-center gap-3 py-1.5">
		<div class="flex min-w-0 items-center gap-2">
			<span class="cat-icon cat-icon-sm" style={ "color:" + ColorOr(c.Color) }>
				@iconSVG(IconOr(c.Icon, c.Label))
			</span>
			<span class="truncate text-sm text-slate-600 dark:text-slate-400">{ c.Label }</span>
		</div>
		<div class="bar-track">
			<div class="bar-fill" style={ "width:" + BarWidth(c.Cents, max) + ";background-color:" + ColorOr(c.Color) }></div>
		</div>
		<div class="tnum w-14 text-right text-xs text-slate-400 dark:text-slate-500">{ SharePercent(c.Cents, total) }</div>
		<div class="tnum text-right text-sm text-slate-700 dark:text-slate-300">{ FormatEUR(c.Cents) }</div>
	</div>
}

templ tagCard(vm DashboardVM) {
	<div class="card">
		<div class="card-head">
			<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ T(ctx, "dash.byTag") }</h2>
		</div>
		if len(vm.Report.Tags) == 0 {
			<p class="text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "dash.noTagData") }</p>
		} else {
			for _, t := range vm.Report.Tags {
				@categoryBar(t, MaxLabeled(vm.Report.Tags), vm.Report.ExpenseCents)
			}
		}
	</div>
}
