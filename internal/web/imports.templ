package web

import (
	"strconv"

	"github.com/daknoblo/Haushaltsbuch/internal/store"
)

templ ImportsPage(nav Nav, vm ImportVM) {
	@Layout(nav) {
		@pageHeading(T(ctx, "nav.imports"), T(ctx, "import.subtitle"))
		if vm.MappingMessage!="" {
			<p class="alert-error mb-3" role="alert">{ vm.MappingMessage }</p>
		}
		if nav.ActiveHousehold.ID == 0 {
			@noHousehold()
		} else {
			@ImportUploader(nav, vm)
			@ImportUploadHistory(nav, vm)
			@ImportReview(nav, vm)
			<script src={ nav.AssetURL("imports.js") } defer></script>
		}
	}
}

templ ImportReview(nav Nav, vm ImportVM) {
	<div id="import-review" data-review-month={ nav.Month } tabindex="-1">
		<div data-review-toolbar>
			<section class="card mt-4">
				<div class="flex flex-wrap items-center gap-3">
					<h2 class="font-semibold">{ nav.CurrentMonthLabel(ctx) }</h2>
					<form method="get" action="/imports" class="flex min-w-0 gap-2" data-import-month-form>
						<input type="month" class="input min-w-0" name="m" value={ nav.Month } aria-label={ T(ctx, "pdf.month") } required/>
						<button class="btn-ghost" type="submit">{ T(ctx, "import.show") }</button>
					</form>
					<a class="btn-ghost" href={ templ.SafeURL("/?m=" + nav.Month) }>{ T(ctx, "basis.comparison") }</a>
				</div>
				<p class="my-3 text-sm">{ T(ctx, "import.closeHint") }</p>
				<p class="mb-2 text-sm font-semibold">{ Tf(ctx,"review.progress",len(vm.Rows)-vm.DecisionCount("pending"),len(vm.Rows),vm.DecisionCount("pending")) }</p>
				<p class="mb-3 text-sm text-slate-500 dark:text-slate-400">
					if nav.Month>=NormalizeMonth("") {
						{ T(ctx,"review.monthPlan") }
					} else if vm.Closed {
						{ T(ctx,"review.monthActual") }
					} else {
						{ T(ctx,"review.monthEstimate") }
					}
				</p>
				<form method="post" action="/imports/month" class="flex flex-wrap items-center gap-3">
					@importHouseholdField(nav)
					<input type="hidden" name="month" value={ nav.Month }/>
					if vm.Closed {
						<span class="badge badge-ok">{ T(ctx, "import.closed") }</span>
						<button class="btn-ghost" type="submit" name="closed" value="no">{ T(ctx, "import.reopenMonth") }</button>
					} else {
						<label class="flex items-start gap-2"><input type="checkbox" name="complete" value="yes" required/>{ T(ctx, "import.complete") }</label>
						<button class="btn-primary" type="submit" name="closed" value="yes" disabled?={ vm.DecisionCount("pending")>0 || nav.Month>=NormalizeMonth("") } title={ T(ctx, "review.closeBlocked") }>{ T(ctx, "import.closeMonth") }</button>
					}
				</form>
			</section>
		</div>
		<div class="mt-4 grid gap-2">
			<div class="flex flex-wrap items-center gap-2" data-review-counts>
				<h2 class="mr-auto font-semibold">{ T(ctx, "import.paymentOverview") }</h2>
				for _, decision := range []string{"pending", "accepted", "transfer", "ignored"} {
					<span class={ "badge whitespace-nowrap", ImportDecisionBadge(decision) }>
						{ strconv.Itoa(vm.DecisionCount(decision)) } { ImportDecisionLabel(ctx, decision) }
					</span>
				}
			</div>
			<div class="card-tight" data-review-controls>
				<div class="card-body grid gap-3">
					<p class="text-sm text-slate-500 dark:text-slate-400">{ T(ctx,"review.stageHint") }</p>
					<div class="flex flex-wrap gap-2" data-review-filters>
						<button class="btn-ghost" type="button" data-review-filter="all" aria-pressed="true" disabled>{ T(ctx, "review.all") } · { strconv.Itoa(len(vm.Rows)) }</button>
						for _, stage:=range []string{"ready","suggested","needs","done"} {
							<button class="btn-ghost" type="button" data-review-filter={ stage } aria-pressed="false" disabled>{ ReviewStageLabel(ctx, stage) } · { strconv.Itoa(vm.StageCount(stage)) }</button>
						}
					</div>
					<div class="flex flex-wrap items-center gap-2">
						<button class="btn-ghost" type="button" data-select-ready disabled>{ T(ctx, "review.selectReady") }</button>
						<button class="btn-ghost" type="button" data-select-visible disabled>{ T(ctx,"review.selectVisible") }</button>
						<button class="btn-ghost" type="button" data-clear-selection disabled>{ T(ctx, "review.clearSelection") }</button>
						<span class="text-sm"><strong data-selected-count>0</strong> { T(ctx,"review.selected") }</span>
						<button class="btn-primary" type="submit" form="bank-bulk-form" name="operation" value="accept" data-bulk-accept disabled>{ T(ctx,"review.acceptSelected") }</button>
					</div>
					<form id="bank-bulk-form" method="post" action="/imports/review-batch" class="grid gap-2 md:grid-cols-4" data-bank-bulk>
						@importHouseholdField(nav)
						<input type="hidden" name="upload_generation" value={ strconv.FormatUint(vm.UploadGeneration, 10) }/>
						<input type="hidden" name="month" value={ nav.Month }/>
						<label>
							{ T(ctx,"import.category") }
							<select name="category" class="input w-full">
								<option value="">{ T(ctx,"import.choose") }</option>
								for _, c:=range vm.Data.Categories {
									<option value={ strconv.FormatInt(c.ID, 10) } data-direction={ string(c.Classification) }>{ c.Name } · { DirectionLabel(ctx, c.Classification) }</option>
								}
							</select>
						</label>
						<label>
							{ T(ctx,"overview.costNature") }
							<select name="nature" class="input w-full">
								<option value="">{ T(ctx,"review.keep") }</option>
								for _, value:=range []store.CostNature{store.CostFix,store.CostVariable} {
									<option value={ string(value) }>{ CostNatureLabel(ctx,value) }</option>
								}
							</select>
						</label>
						<label>
							{ T(ctx,"overview.budgetClasses") }
							<select name="class" class="input w-full">
								<option value="">{ T(ctx,"review.keep") }</option>
								for _, value:=range []store.BudgetClass{store.ClassNeed,store.ClassWant,store.ClassSaving} {
									<option value={ string(value) }>{ BudgetClassLabel(ctx,value) }</option>
								}
							</select>
						</label>
						<button class="btn-ghost self-end" type="submit" name="operation" value="category" data-bulk-category disabled>{ T(ctx,"review.applyCategory") }</button>
					</form>
					<p class="text-xs text-slate-500 dark:text-slate-400">{ T(ctx,"review.bulkHint") }</p>
					<form method="post" action="/imports/analyze" data-bank-analyze>
						@importHouseholdField(nav)
						<input type="hidden" name="upload_generation" value={ strconv.FormatUint(vm.UploadGeneration, 10) }/>
						<input type="hidden" name="month" value={ nav.Month }/>
						<button class="btn-ghost" type="submit" disabled?={ !vm.CanAnalyze || vm.AnalysisCount() == 0 } data-ai-available={ strconv.FormatBool(vm.CanAnalyze) } data-ai-count={ strconv.Itoa(vm.AnalysisCount()) } title={ T(ctx, "review.aiButtonHint") }>{ T(ctx, "review.aiAnalyze") } · { strconv.Itoa(vm.AnalysisCount()) }</button>
					</form>
					<p class="text-xs text-slate-500 dark:text-slate-400">
						if vm.CanAnalyze {
							{ T(ctx, "review.aiAutomatic") }
						} else {
							{ T(ctx, "review.aiUnavailable") }
						}
					</p>
					<p class="alert-info" data-review-operation-status role="status" aria-live="polite" hidden></p>
					<p class="alert-error" data-review-operation-error role="alert" hidden></p>
				</div>
			</div>
			<div class="grid gap-2" data-bank-rows>
				if len(vm.Rows) == 0 {
					<p class="alert-info" data-review-empty>{ T(ctx, "import.empty") }</p>
				}
				for _, row := range vm.Rows {
					@importPayment(nav, vm, row)
				}
			</div>
		</div>
		<section class="card mt-4" data-review-months hidden?={ len(vm.PendingMonths)==0 }>
			<h2 class="font-semibold">{ T(ctx, "import.otherMonths") }</h2>
			<div class="mt-3 flex flex-wrap gap-2">
				for _, month := range vm.PendingMonths {
					<a class="btn-ghost" href={ templ.SafeURL(importMonthURL(month.Month)) } data-review-month-link>{ MonthLabel(ctx,month.Month) } · { UsageLabel(ctx,month.Count) }</a>
				}
			</div>
		</section>
	</div>
}

templ importHouseholdField(nav Nav) {
	<input type="hidden" name="household" value={ strconv.FormatInt(nav.ActiveHousehold.ID, 10) }/>
}

templ importPayment(nav Nav, vm ImportVM, row ImportRow) {
	<article id={ row.ID() } data-bank-row={ strconv.FormatInt(row.Payment.ID, 10) } data-review-stage={ row.Stage } data-review-token={ row.ReviewToken() } data-review-match={ row.MatchKey() } data-review-quick={ strconv.FormatBool(row.CanQuick) } data-review-direction={ string(row.Payment.Direction) } data-review-category-ready={ strconv.FormatBool(row.Payment.PlanID != 0 || len(row.Payment.Splits) > 0) }>
		<p class="alert-error mb-2" data-payment-error role="alert" hidden></p>
		<details class="import-payment" data-bank-payment={ strconv.FormatInt(row.Payment.ID, 10) }>
			<summary class="import-payment-summary">
				<span class="import-select"><input type="checkbox" data-review-select aria-label={ Tf(ctx, "review.select", row.Payment.Name) } disabled/></span>
				<span class="import-expand" aria-hidden="true">›</span>
				<span class="import-date tnum">{ FormatDate(row.Payment.BookedOn) }</span>
				<span class="import-description">
					<strong class="block truncate" title={ row.Payment.Name }>{ row.Payment.Name }</strong>
					<span class="block truncate text-xs text-slate-500 dark:text-slate-400" title={ row.Account }>{ row.Account }</span>
				</span>
				<span class="import-state">
					<span class={ ReviewStageBadge(row.Stage) }>{ ReviewStageLabel(ctx,row.Stage) }</span>
					if row.Payment.Decision!="pending" {
						<span class={ "badge",ImportDecisionBadge(row.Payment.Decision) }>{ ImportDecisionLabel(ctx,row.Payment.Decision) }</span>
					}
					if row.Duplicate {
						<span class="badge badge-warn whitespace-nowrap" title={ T(ctx, "import.duplicateHint") }>{ T(ctx, "import.duplicateShort") }</span>
					}
					if row.TransferCandidate != "" {
						<span class="badge badge-info whitespace-nowrap" title={ row.TransferCandidate }>{ T(ctx, "import.transferShort") }</span>
					}
					if row.SimilarCandidate!="" {
						<span class="badge badge-warn whitespace-nowrap" title={ row.SimilarCandidate }>{ T(ctx,"import.similarPayment") }</span>
					}
				</span>
				<span class={ "import-amount tnum", templ.KV("text-emerald-700 dark:text-emerald-400", row.Payment.Direction == store.DirIncome), templ.KV("text-rose-700 dark:text-rose-400", row.Payment.Direction == store.DirExpense) }>
					<span class="sr-only">{ DirectionLabel(ctx, row.Payment.Direction) }</span>
					{ row.SignedAmount() }
				</span>
				<span class="import-actions">
					if row.Payment.Decision=="pending" && !row.Closed {
						<button class="btn-primary sm:px-3 sm:py-1.5 sm:text-xs" type="submit" form={ row.FormID() } name="quick" value="yes" aria-label={ Tf(ctx, "import.quickAcceptFor", row.Payment.Name) } data-bank-quick disabled?={ !row.CanQuick } title={ T(ctx, "review.stageHint") }>{ T(ctx, "import.quickAccept") }</button>
					}
				</span>
				<span class="import-labels">
					if row.Category!="" {
						<span class="badge badge-info">{ row.Category }</span>
					} else {
						<span class="badge badge-warn">{ T(ctx,"import.categoryMissing") }</span>
					}
					if row.Payment.Direction==store.DirExpense {
						<span class="badge badge-muted">
							{ CostNatureLabel(ctx,row.Payment.CostNature) }
							if row.NatureDefault {
								· { T(ctx,"review.default") }
							}
						</span>
						<span class="badge badge-muted">
							{ BudgetClassLabel(ctx,row.Payment.BudgetClass) }
							if row.ClassDefault {
								· { T(ctx,"review.default") }
							}
						</span>
						if !row.Payment.Settle {
							<span class="badge badge-muted">{ T(ctx,"import.noSettlement") }</span>
						}
					}
					if row.AllocationLabel!="" {
						<span class="badge badge-muted max-w-full whitespace-normal text-left">{ row.AllocationLabel }</span>
						if row.AllocationDefault {
							<span class="text-xs text-slate-500 dark:text-slate-400">{ T(ctx,"review.ownerDefault") }</span>
						}
					}
					if row.PlanName!="" {
						<a class="badge badge-info max-w-full whitespace-normal text-left underline" href={ templ.SafeURL(row.PlanURL()) }>{ Tf(ctx,"import.planLabel",row.PlanName) }</a>
						<span class={ "badge",templ.KV("badge-warn",row.PlanAmount!=row.Payment.AmountCents),templ.KV("badge-muted",row.PlanAmount==row.Payment.AmountCents) }>{ Tf(ctx,"review.planAmount",FormatEUR(row.PlanAmount),FormatEUR(row.Payment.AmountCents),row.PlanDifference()) }</span>
						if row.PlanOwnerMismatch {
							<span class="badge badge-warn">{ T(ctx,"review.planOwner") }</span>
						}
					}
					for _, tag:=range row.Tags {
						<span class="badge badge-muted">{ tag.Name }</span>
					}
					if row.Suggestion!="" {
						<span class="text-xs text-slate-500 dark:text-slate-400">{ ImportSuggestionLabel(ctx,row.Suggestion) }</span>
					}
					if row.AIReason!="" {
						<span class="block w-full min-w-0 break-words text-xs text-slate-600 dark:text-slate-300">{ row.AIReason }</span>
					}
					if row.TransferPairLabel!="" {
						<span class="block w-full min-w-0 break-words text-xs">{ T(ctx, "review.pair") }: { row.TransferPairLabel }</span>
					}
				</span>
			</summary>
			<div class="import-payment-body">
				<p class="mb-3 text-xs text-slate-500 dark:text-slate-400">{ row.Source }</p>
				if row.Duplicate {
					<p class="alert-error mb-3">{ T(ctx, "import.duplicateHint") }</p>
				}
				if row.TransferCandidate != "" {
					<p class="alert-info mb-3">{ T(ctx, "import.transferHint") } { row.TransferCandidate }</p>
				}
				if row.SimilarCandidate!="" {
					<p class="alert-info mb-3">{ T(ctx,"import.similarHint") } { row.SimilarCandidate }</p>
				}
				if row.PlanName != "" {
					<p class="alert-info mb-3">
						{ T(ctx, "import.match") } { row.PlanName } · { FormatEUR(row.PlanAmount) }
						if row.PlanAmount != row.Payment.AmountCents {
							<span>· { T(ctx, "import.deviation") }</span>
						}
					</p>
				}
				if row.Payment.Decision == "pending" && !row.Closed {
					<form id={ row.FormID() } method="post" action={ row.URL() } class="grid gap-3" data-bank-review-form>
						@importHouseholdField(nav)
						<input type="hidden" name="review_token" value={ row.ReviewToken() }/>
						<input type="hidden" name="upload_generation" value={ strconv.FormatUint(vm.UploadGeneration, 10) }/>
						<input type="hidden" name="history_id" value={ strconv.FormatInt(row.HistoryID, 10) }/>
						<div class="grid gap-3 md:grid-cols-4">
							<label>{ T(ctx, "import.date") }<input class="input w-full" name="date" type="date" value={ row.Payment.BookedOn } required/></label>
							<label>{ T(ctx, "import.amount") }<input class="input w-full" name="amount" inputmode="decimal" value={ FormatCents(row.Payment.AmountCents) } required/></label>
							<label>
								{ T(ctx, "settings.kind") }
								<select class="input w-full" name="direction">
									for _, o := range DirectionOptions(ctx) {
										<option value={ o.Value } selected?={ o.Value == string(row.Payment.Direction) }>{ o.Label }</option>
									}
								</select>
							</label>
							<label>{ T(ctx, "settings.name") }<input class="input w-full" name="name" value={ row.Payment.Name } maxlength="120" required/></label>
						</div>
						<label>{ T(ctx, "import.reference") }<textarea class="input w-full" name="reference" maxlength="2000">{ row.Payment.Reference }</textarea></label>
						<div class="grid gap-3 md:grid-cols-3">
							<label>
								{ T(ctx, "import.category") }
								<select class="input w-full" name="category">
									<option value="0">{ T(ctx, "import.choose") }</option>
									for _, c := range vm.Data.Categories {
										<option value={ strconv.FormatInt(c.ID, 10) } selected?={ c.ID == row.Payment.CategoryID }>{ c.Name } · { DirectionLabel(ctx, c.Classification) }</option>
									}
								</select>
							</label>
							<label>
								{ T(ctx, "import.plan") }
								<select class="input w-full" name="plan">
									<option value="0">{ T(ctx, "import.noPlan") }</option>
									for _, b := range vm.Data.Bookings {
										<option value={ strconv.FormatInt(b.ID, 10) } selected?={ b.ID == row.Payment.PlanID }>{ b.Name }</option>
									}
								</select>
							</label>
							<label>
								{ T(ctx, "import.allocation") }
								<select class="input w-full" name="allocation">
									<option value="owner" selected?={ row.Allocation == "owner" }>{ T(ctx, "import.allocateOwner") }</option>
									<option value="plan" selected?={ row.Allocation == "plan" }>{ T(ctx, "import.allocatePlan") }</option>
									if row.HistoryID!=0 {
										<option value="history" selected?={ row.Allocation=="history" }>{ T(ctx,"import.allocateHistory") }</option>
									}
									if row.Allocation == "draft" {
										<option value="draft" selected>{ T(ctx,"review.allocateDraft") }</option>
									}
								</select>
							</label>
							<label>
								{ T(ctx, "overview.costNature") }
								<select class="input w-full" name="nature">
									for _, key := range []string{"fix", "variable"} {
										<option value={ key } selected?={ key == string(row.Payment.CostNature) }>{ CostNatureLabel(ctx, store.CostNature(key)) }</option>
									}
								</select>
							</label>
							<label>
								{ T(ctx, "overview.budgetClasses") }
								<select class="input w-full" name="class">
									for _, key := range []string{"need", "want", "saving"} {
										<option value={ key } selected?={ key == string(row.Payment.BudgetClass) }>{ BudgetClassLabel(ctx, store.BudgetClass(key)) }</option>
									}
								</select>
							</label>
							<label>
								{ T(ctx, "import.transferAccount") }
								<select class="input w-full" name="transfer_account">
									<option value="0">{ T(ctx, "import.choose") }</option>
									for _, a := range vm.Ledger.Accounts {
										if a.ID != row.AccountID {
											<option value={ strconv.FormatInt(a.ID, 10) } selected?={ a.ID == row.Payment.TransferAccountID }>{ BankAccountLabel(ctx, a, vm.Data.Members) }</option>
										}
									}
								</select>
							</label>
						</div>
						<label class="flex gap-2"><input type="checkbox" name="settle" value="yes" checked?={ row.Payment.Settle }/>{ T(ctx, "import.settle") }</label>
						<label class="flex gap-2"><input type="checkbox" name="allow_duplicate" value="yes"/>{ T(ctx, "import.allowDuplicate") }</label>
						<div class="flex flex-wrap gap-2">
							<button class="btn-primary" type="submit" name="decision" value="accepted">{ T(ctx, "import.accept") }</button>
							<button class="btn-ghost" type="submit" name="decision" value="pending">{ T(ctx, "import.keepDraft") }</button>
							<button class="btn-ghost" type="submit" name="decision" value="transfer" disabled?={ len(vm.Ledger.Accounts) < 2 }>{ T(ctx, "import.markTransfer") }</button>
							<button class="btn-ghost" type="submit" name="decision" value="ignored">{ T(ctx, "import.ignore") }</button>
						</div>
					</form>
				} else {
					<p class="text-sm">{ row.Payment.Reference }</p>
					for _, sp := range row.Payment.Splits {
						for _, m := range vm.Data.Members {
							if m.ID == sp.MemberID {
								<p class="text-sm">{ m.Name }: { FormatEUR(sp.Cents) }</p>
							}
						}
					}
					if !row.Closed {
						<form method="post" action={ row.URL() } class="mt-3">
							@importHouseholdField(nav)
							<button class="btn-ghost" type="submit" name="decision" value="pending">{ T(ctx, "import.reopenPayment") }</button>
						</form>
					}
					if row.Payment.Decision == "accepted" && row.Payment.PlanID == 0 {
						<form method="post" action={ row.URL() + "/plan" } class="mt-3 flex flex-wrap items-end gap-3">
							@importHouseholdField(nav)
							<label>{ T(ctx, "import.futureStart") }<input class="input" type="date" name="start" value={ ShiftMonth(NormalizeMonth(""), 1) + "-01" } required/></label>
							<label>
								{ T(ctx, "import.frequency") }
								<select class="input" name="frequency">
									for _, f := range []store.Frequency{store.FreqOnce, store.FreqMonthly, store.FreqQuarterly, store.FreqYearly} {
										<option value={ string(f) }>{ FrequencyLabel(ctx, f) }</option>
									}
								</select>
							</label>
							<button class="btn-ghost" type="submit">{ T(ctx, "import.createPlan") }</button>
						</form>
					}
				}
			</div>
		</details>
		if row.Payment.Decision=="pending" && row.TransferCandidate!="" && !row.Closed {
			<form method="post" action="/imports/review-batch" class="mt-2" data-bank-pair>
				@importHouseholdField(nav)
				<input type="hidden" name="upload_generation" value={ strconv.FormatUint(vm.UploadGeneration, 10) }/>
				<input type="hidden" name="month" value={ nav.Month }/>
				<input type="hidden" name="operation" value="transfer"/>
				<input type="hidden" name="payment" value={ strconv.FormatInt(row.Payment.ID, 10) }/>
				<input type="hidden" name="pair_token" value={ row.TransferPairToken }/>
				<button class="btn-ghost" type="submit" disabled?={ row.TransferPairID == 0 } title={ T(ctx, "review.pairConfirm") }>{ T(ctx, "review.confirmPair") }</button>
			</form>
		}
		if row.Payment.Decision=="accepted" {
			<button class="btn-ghost mt-2" type="button" data-copy-classification data-copy-category={ strconv.FormatInt(row.Payment.CategoryID, 10) } data-copy-nature={ string(row.Payment.CostNature) } data-copy-class={ string(row.Payment.BudgetClass) } data-copy-count={ strconv.Itoa(vm.CopyCount(row)) } disabled title={ T(ctx, "review.copyHint") }>{ T(ctx, "review.copy") } · { strconv.Itoa(vm.CopyCount(row)) }</button>
		}
	</article>
}
