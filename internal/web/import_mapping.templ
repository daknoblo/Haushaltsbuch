package web

import "strconv"

templ ImportMappingCard(nav Nav, vm ImportMappingVM) {
	<article class="upload-history-row grid gap-3 scroll-mt-4" id={ vm.ID() } data-import-mapping data-pending-upload-url={ vm.URL() } tabindex="-1">
		<div class="flex flex-wrap items-center gap-2">
			<strong class="min-w-0 flex-1 break-all">{ vm.Filename }</strong>
			<span class="badge badge-warn">{ Tf(ctx,"import.mappingCount",len(vm.Sources)) }</span>
		</div>
		<p class="text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "import.mappingHint") }</p>
		<div class="flex flex-wrap gap-2">
			<a class="btn-ghost" href="/settings#bank-accounts" target="_blank" rel="noopener">{ T(ctx, "import.manageBankAccounts") }</a>
			<a class="btn-ghost" href={ templ.SafeURL(vm.URL()) } data-refresh-mapping>{ T(ctx, "import.refreshAccounts") }</a>
		</div>
		<p class="alert-error" role="alert" data-mapping-error hidden></p>
		<form method="post" action="/imports/mapping" class="grid gap-3">
			@importHouseholdField(nav)
			<input type="hidden" name="preview" value={ vm.Token }/>
			for i, source := range vm.Sources {
				<div class="grid min-w-0 items-center gap-3 rounded-lg border border-slate-200 p-3 md:grid-cols-2 dark:border-slate-800" data-source-account>
					<div class="min-w-0">
						<strong class="block break-words">
							if source.Name != "" {
								{ source.Name }
							} else {
								{ Tf(ctx, "import.sourceOrdinal", i+1) }
							}
						</strong>
						if source.Suffix != "" {
							<span class="text-sm text-slate-500 dark:text-slate-400">{ Tf(ctx, "import.sourceSuffix", source.Suffix) }</span>
						}
						<p class="text-sm">{ UsageLabel(ctx, len(source.Payments)) }</p>
					</div>
					<label class="min-w-0">
						{ Tf(ctx, "import.mappingDestination", i+1) }
						<select class="input mt-1 w-full" name={ "target_" + strconv.Itoa(i) } required>
							<option value="" selected?={ vm.Selected[i]==0 }>{ T(ctx, "import.choose") }</option>
							for _, account := range vm.Accounts {
								<option value={ strconv.FormatInt(account.ID, 10) } selected?={ vm.Selected[i]==account.ID }>{ BankAccountLabel(ctx,account,vm.Members) }</option>
							}
						</select>
					</label>
				</div>
			}
			<button class="btn-primary max-w-full justify-self-start whitespace-normal text-left" type="submit">{ T(ctx, "import.confirmMapping") }</button>
		</form>
		<form method="post" action="/imports/mapping/cancel">
			@importHouseholdField(nav)
			<input type="hidden" name="preview" value={ vm.Token }/>
			<button class="btn-ghost" type="submit">{ T(ctx, "import.cancelMapping") }</button>
		</form>
		<p class="text-xs text-slate-500 dark:text-slate-400">{ T(ctx, "import.mappingLifetime") }</p>
	</article>
}
