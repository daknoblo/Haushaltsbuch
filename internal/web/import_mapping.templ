package web

import "strconv"

templ ImportMappingCard(nav Nav, vm ImportMappingVM) {
	<article class="upload-history-row grid gap-3 scroll-mt-4" id={ vm.ID() } data-import-mapping data-pending-upload-url={ vm.URL() } tabindex="-1">
		<div class="upload-file-header">
			<strong class="upload-file-title">{ vm.Filename }</strong>
			<span class="badge badge-warn">{ Tf(ctx,"import.mappingCount",len(vm.Sources)) }</span>
		</div>
		<p class="text-sm text-slate-500 dark:text-slate-400">{ T(ctx, "import.mappingHint") }</p>
		<p class="alert-error" role="alert" data-mapping-error hidden></p>
		<form id={ vm.ID() + "-confirm" } method="post" action="/imports/mapping" class="grid gap-3">
			@importHouseholdField(nav)
			<input type="hidden" name="preview" value={ vm.Token }/>
			for i, source := range vm.Sources {
				<div class={ "import-account-row", templ.KV("import-account-row-alt", i%2==1) } data-source-account>
					<div class="min-w-0">
						<strong class="block break-words">
							if source.Name != "" {
								{ source.Name }
							} else {
								{ Tf(ctx, "import.sourceOrdinal", i+1) }
							}
						</strong>
						if source.Suffix != "" {
							<span class="text-sm text-slate-600 dark:text-slate-400">{ Tf(ctx, "import.sourceSuffix", source.Suffix) }</span>
						}
						<p class="text-sm">{ UsageLabel(ctx, len(source.Payments)) }</p>
					</div>
					<label class="min-w-0">
						{ Tf(ctx, "import.mappingDestination", i+1) }
						<select class="input mt-1 w-full" name={ "target_" + strconv.Itoa(i) } required>
							<option value="" selected?={ vm.Selected[i]==0 }>{ T(ctx, "import.choose") }</option>
							for _, account := range vm.Accounts {
								<option value={ strconv.FormatInt(account.ID, 10) } selected?={ vm.Selected[i]==account.ID }>{ BankAccountLabel(ctx,account,vm.Members) }</option>
							}
						</select>
					</label>
				</div>
			}
		</form>
		<div class="grid grid-cols-2 items-stretch gap-2 sm:flex" data-mapping-actions>
			<button class="btn-primary min-w-0 whitespace-normal" type="submit" form={ vm.ID() + "-confirm" }>{ T(ctx, "import.confirmMapping") }</button>
			<form method="post" action="/imports/mapping/cancel" class="grid min-w-0">
				@importHouseholdField(nav)
				<input type="hidden" name="preview" value={ vm.Token }/>
				<button class="btn-danger whitespace-normal" type="submit">{ T(ctx, "import.cancelMapping") }</button>
			</form>
		</div>
		<p class="text-xs text-slate-500 dark:text-slate-400">{ T(ctx, "import.mappingLifetime") }</p>
	</article>
}
