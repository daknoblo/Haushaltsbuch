package web

import "github.com/daknoblo/Haushaltsbuch/internal/store"

templ OverviewPage(nav Nav, vm OverviewVM) {
	@Layout(nav) {
		@pageHeading("Übersicht", nav.CurrentMonthLabel()) {
			<a class="btn-ghost ml-auto no-print" href={ templ.SafeURL("/export/overview.pdf?m=" + nav.Month) }>PDF exportieren</a>
		}
		if nav.ActiveHousehold.ID == 0 {
			@noHousehold()
		} else {
			<div class="grid gap-4 sm:grid-cols-3">
				@statTile("Einnahmen", FormatEUR(vm.Report.IncomeCents), nav.CurrentMonthLabel(), "text-emerald-600 dark:text-emerald-400")
				@statTile("Ausgaben", FormatEUR(vm.Report.ExpenseCents), "monatlich normalisiert", "text-rose-600 dark:text-rose-400")
				@statTile("Saldo", FormatEUR(vm.Report.BalanceCents), "Einnahmen − Ausgaben", balanceTone(vm.Report.BalanceCents))
			</div>
			<div class="mt-4 grid gap-4 lg:grid-cols-2">
				<div class="card-tight">
					<div class="card-head">
						<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">Personen</h2>
					</div>
					<div class="overflow-x-auto">
						<table class="w-full">
							<thead>
								<tr>
									<th class="table-head">Person</th>
									<th class="table-head text-right">Einnahmen</th>
									<th class="table-head text-right">Ausgaben</th>
									<th class="table-head text-right">Saldo</th>
								</tr>
							</thead>
							<tbody>
								for _, m := range vm.Report.Members {
									<tr>
										<td class="table-cell">
											<span class="flex items-center gap-2">
												@memberDot(m.Member.Color)
												{ m.Member.Name }
											</span>
										</td>
										<td class="table-cell tnum text-right">{ FormatEUR(m.IncomeCents) }</td>
										<td class="table-cell tnum text-right">{ FormatEUR(m.ExpenseCents) }</td>
										<td class="table-cell text-right">
											@signedMoney(m.BalanceCents)
										</td>
									</tr>
								}
								if vm.Report.UnassignedCents != 0 {
									<tr>
										<td class="table-cell text-slate-500 dark:text-slate-400">Nicht zugeordnet</td>
										<td class="table-cell text-right text-slate-400">—</td>
										<td class="table-cell tnum text-right text-slate-500 dark:text-slate-400">{ FormatEUR(vm.Report.UnassignedCents) }</td>
										<td class="table-cell text-right text-slate-400">—</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
				<div class="card">
					<h2 class="mb-3 text-base font-semibold text-slate-900 dark:text-slate-100">Nach Sektion</h2>
					if len(vm.Report.Sections) == 0 {
						<p class="alert-info">Noch keine Ausgaben erfasst.</p>
					} else {
						for _, s := range vm.Report.Sections {
							@hbar(s.Label, s.Cents, MaxLabeled(vm.Report.Sections))
						}
					}
				</div>
			</div>
			<div class="mt-4 grid gap-4 lg:grid-cols-3">
				<div class="card">
					<h3 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">Nach Kategorie</h3>
					if len(vm.Report.Categories) == 0 {
						<p class="alert-info">Keine Kategorien.</p>
					} else {
						for _, c := range vm.Report.Categories {
							@hbar(c.Label, c.Cents, MaxLabeled(vm.Report.Categories))
						}
					}
				</div>
				<div class="card">
					<h3 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">Fix / Variabel</h3>
					@breakdownRow("Fix", "badge-info", vm.Report.ByCostNature[store.CostFix])
					@breakdownRow("Variabel", "badge-warn", vm.Report.ByCostNature[store.CostVariable])
				</div>
				<div class="card">
					<h3 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">Bedarf / Wunsch / Sparen</h3>
					@breakdownRow("Bedarf", "badge-muted", vm.Report.ByBudgetClass[store.ClassNeed])
					@breakdownRow("Wunsch", "badge-warn", vm.Report.ByBudgetClass[store.ClassWant])
					@breakdownRow("Sparen", "badge-ok", vm.Report.ByBudgetClass[store.ClassSaving])
				</div>
			</div>
		}
	}
}

templ statTile(label string, value string, sub string, tone string) {
	<div class="card">
		<div class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">{ label }</div>
		<div class={ "tnum mt-1 text-2xl font-semibold tracking-tight", tone }>{ value }</div>
		<div class="mt-0.5 text-xs text-slate-400 dark:text-slate-500">{ sub }</div>
	</div>
}

templ breakdownRow(label string, badgeClass string, cents int64) {
	<div class="flex items-center gap-3 border-b border-slate-200/70 py-2 last:border-0 dark:border-slate-800/60">
		<span class={ "badge", badgeClass }>{ label }</span>
		<span class="tnum ml-auto text-sm text-slate-700 dark:text-slate-300">{ FormatEUR(cents) }</span>
	</div>
}
