package web

import (
	"strconv"

	"github.com/daknoblo/Haushaltsbuch/internal/store"
)

templ Layout(nav Nav) {
	<!DOCTYPE html>
	<html lang={ LangCode(ctx) } class="h-full dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content="{&#34;includeIndicatorStyles&#34;:false}"/>
			<title>{ PageTitle(ctx, nav.Active) } · { T(ctx, "app.name") }</title>
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%236366f1'/%3E%3Ctext x='16' y='23' font-family='sans-serif' font-size='20' font-weight='700' fill='white' text-anchor='middle'%3EH%3C/text%3E%3C/svg%3E"/>
			<link rel="stylesheet" href={ nav.AssetURL("app.css") }/>
			// Applies the stored theme before first paint to avoid a flash.
			<script src={ nav.AssetURL("theme.js") }></script>
		</head>
		<body class="min-h-full bg-slate-50 text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-200">
			@topbar(nav)
			<main class="mx-auto max-w-[110rem] px-4 pb-16 pt-6">
				{ children... }
			</main>
			<div id="save-indicator" class="save-indicator">
				<span class="dot bg-emerald-400"></span> { T(ctx, "status.saved") }
			</div>
			<script src={ nav.AssetURL("htmx.min.js") } defer></script>
			<script src={ nav.AssetURL("app.js") } defer></script>
		</body>
	</html>
}

templ topbar(nav Nav) {
	<header class="border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-900/60">
		<div class="mx-auto flex max-w-[110rem] flex-wrap items-center gap-3 px-4 py-3">
			<a href="/" class="flex items-center gap-2 text-lg font-semibold tracking-tight text-slate-900 transition hover:text-indigo-600 dark:text-slate-100 dark:hover:text-indigo-400">
				<span class="grid h-7 w-7 place-items-center rounded-lg bg-indigo-500 text-sm font-bold text-white">H</span>
				{ T(ctx, "app.name") }
			</a>
			<button type="button" class="nav-toggle ml-auto" data-nav-toggle aria-label={ T(ctx, "nav.menu") } aria-expanded="false">
				<span aria-hidden="true">☰</span>
			</button>
			<nav class="hidden flex-wrap items-center gap-1 text-sm md:flex">
				@navLink(nav, "overview", "/", T(ctx, "nav.overview"))
				@navLink(nav, "bookings", "/bookings", T(ctx, "nav.bookings"))
				@navLink(nav, "dashboard", "/dashboard", T(ctx, "nav.dashboard"))
				@navLink(nav, "settings", "/settings", T(ctx, "nav.settings"))
			</nav>
			<div class="ml-auto hidden items-center gap-2 md:flex">
				if nav.ShowMonthNav {
					@monthNav(nav)
				}
				@householdPicker(nav)
				@themeToggle()
			</div>
			<div class="w-full md:hidden" data-nav-panel hidden>
				<nav class="nav-panel">
					@navLink(nav, "overview", "/", T(ctx, "nav.overview"))
					@navLink(nav, "bookings", "/bookings", T(ctx, "nav.bookings"))
					@navLink(nav, "dashboard", "/dashboard", T(ctx, "nav.dashboard"))
					@navLink(nav, "settings", "/settings", T(ctx, "nav.settings"))
				</nav>
				<div class="flex flex-wrap items-center gap-2 pb-2">
					if nav.ShowMonthNav {
						@monthNav(nav)
					}
					@householdPicker(nav)
					@themeToggle()
				</div>
			</div>
		</div>
	</header>
}

// householdPicker sits at the far right next to the month navigation. A single
// household needs no switch, so it only appears once there is a choice.
templ householdPicker(nav Nav) {
	if len(nav.Households) > 1 {
		<select
			class="select-filter max-w-[10rem]"
			name="id"
			aria-label={ T(ctx, "nav.household") }
			hx-post="/households/activate"
			hx-trigger="change"
			hx-swap="none"
		>
			for _, h := range nav.Households {
				<option value={ strconv.FormatInt(h.ID, 10) } selected?={ h.ID == nav.ActiveHousehold.ID }>{ h.Name }</option>
			}
		</select>
	}
}

templ navLink(nav Nav, name string, href string, label string) {
	if nav.IsActive(name) {
		<a href={ templ.SafeURL(href) } class="nav-link nav-link-active" aria-current="page">{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class="nav-link">{ label }</a>
	}
}

templ monthNav(nav Nav) {
	<div class="flex items-center gap-1 no-print">
		<a class="btn-icon" href={ templ.SafeURL(nav.MonthURL(nav.PrevMonth())) } aria-label={ T(ctx, "nav.prevMonth") }>‹</a>
		<span class="min-w-[8rem] text-center text-sm font-medium text-slate-700 dark:text-slate-300">{ nav.CurrentMonthLabel(ctx) }</span>
		<a class="btn-icon" href={ templ.SafeURL(nav.MonthURL(nav.NextMonth())) } aria-label={ T(ctx, "nav.nextMonth") }>›</a>
	</div>
}

templ themeToggle() {
	<button type="button" class="btn-icon no-print" data-theme-toggle aria-label={ T(ctx, "nav.theme") }>
		<span class="hidden dark:inline" aria-hidden="true">☾</span>
		<span class="dark:hidden" aria-hidden="true">☀</span>
	</button>
}

// pageHeading renders the title row of a page with optional trailing actions.
templ pageHeading(title string, subtitle string) {
	<div class="mb-5 flex flex-wrap items-center gap-3">
		<div class="min-w-0">
			<h1 class="text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">{ title }</h1>
			if subtitle != "" {
				<p class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">{ subtitle }</p>
			}
		</div>
		{ children... }
	</div>
}

// moveButtons renders the reorder controls for a row. The server answers with
// HX-Refresh, so the surrounding list is redrawn in the new order.
templ moveButtons(baseURL string) {
	<span class="flex items-center gap-1 no-print">
		<button
			type="button"
			class="btn-icon h-8 w-8"
			hx-post={ baseURL + "/move?dir=up" }
			hx-swap="none"
			aria-label={ T(ctx, "action.moveUp") }
		>↑</button>
		<button
			type="button"
			class="btn-icon h-8 w-8"
			hx-post={ baseURL + "/move?dir=down" }
			hx-swap="none"
			aria-label={ T(ctx, "action.moveDown") }
		>↓</button>
	</span>
}

// categoryIcon renders a category's symbol in its own colour.
templ categoryIcon(c store.Category) {
	<span class="cat-icon" style={ "color:" + ColorOr(c.Color) }>
		@iconSVG(IconOr(c.Icon, c.Name))
	</span>
}
