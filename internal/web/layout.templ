package web

import "strconv"

templ Layout(nav Nav) {
	<!DOCTYPE html>
	<html lang="de">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light"/>
			<title>Haushaltsbuch</title>
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%232563eb'/%3E%3Ctext x='16' y='23' font-family='sans-serif' font-size='20' font-weight='700' fill='white' text-anchor='middle'%3EH%3C/text%3E%3C/svg%3E"/>
			<link rel="stylesheet" href={ nav.AssetURL("app.css") }/>
			// Applies the stored theme before first paint to avoid a flash.
			<script src={ nav.AssetURL("theme.js") }></script>
		</head>
		<body>
			@topbar(nav)
			<main class="content">
				{ children... }
			</main>
			<div id="save-indicator" class="save-indicator">
				<span class="dot"></span> Gespeichert
			</div>
			<script src={ nav.AssetURL("htmx.min.js") }></script>
			<script src={ nav.AssetURL("app.js") }></script>
		</body>
	</html>
}

templ topbar(nav Nav) {
	<header class="topbar">
		<div class="topbar-inner">
			<div class="brand">
				<div class="brand-logo">H</div>
				<span>Haushaltsbuch</span>
			</div>
			if len(nav.Households) > 0 {
				<select
					class="select-household"
					name="id"
					hx-post="/households/activate"
					hx-trigger="change"
					hx-swap="none"
				>
					for _, h := range nav.Households {
						<option value={ strconv.FormatInt(h.ID, 10) } selected?={ h.ID == nav.ActiveHousehold.ID }>{ h.Name }</option>
					}
				</select>
			}
			<nav class="nav">
				<a href="/" class={ templ.KV("active", nav.IsActive("overview")) }>Übersicht</a>
				<a href="/expenses" class={ templ.KV("active", nav.IsActive("expenses")) }>Ausgaben</a>
				<a href="/income" class={ templ.KV("active", nav.IsActive("income")) }>Einnahmen</a>
				<a href="/statistics" class={ templ.KV("active", nav.IsActive("statistics")) }>Statistiken</a>
				<a href="/settings" class={ templ.KV("active", nav.IsActive("settings")) }>Einstellungen</a>
			</nav>
			<div class="spacer"></div>
			if nav.ShowMonthNav {
				<div class="month-nav no-print">
					<a class="btn btn-icon btn-sm" href={ templ.SafeURL(nav.MonthURL(nav.PrevMonth())) } aria-label="Vorheriger Monat">‹</a>
					<span class="month-label">{ nav.CurrentMonthLabel() }</span>
					<a class="btn btn-icon btn-sm" href={ templ.SafeURL(nav.MonthURL(nav.NextMonth())) } aria-label="Nächster Monat">›</a>
				</div>
			}
			<button type="button" class="theme-toggle no-print" data-theme-toggle aria-label="Helles oder dunkles Design">
				<span class="icon-light" aria-hidden="true">◑</span>
				<span class="icon-dark" aria-hidden="true">◐</span>
			</button>
		</div>
	</header>
}

// moveButtons renders the reorder controls for a row. The server answers with
// HX-Refresh, so the surrounding list is redrawn in the new order.
templ moveButtons(baseURL string) {
	<span class="flex no-print">
		<button
			type="button"
			class="btn btn-ghost btn-icon btn-sm"
			hx-post={ baseURL + "/move?dir=up" }
			hx-swap="none"
			aria-label="Nach oben"
		>↑</button>
		<button
			type="button"
			class="btn btn-ghost btn-icon btn-sm"
			hx-post={ baseURL + "/move?dir=down" }
			hx-swap="none"
			aria-label="Nach unten"
		>↓</button>
	</span>
}
