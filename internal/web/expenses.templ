package web

import (
	"strconv"

	"github.com/daknoblo/Haushaltsbuch/internal/store"
)

templ ExpensesPage(nav Nav, vm ExpensesVM) {
	@Layout(nav) {
		@pageHeading("Ausgaben", "Änderungen werden automatisch gespeichert.") {
			<div class="ml-auto flex flex-wrap items-center gap-2 no-print">
				<a class="btn-ghost" href="/settings#sektionen">Sektionen verwalten</a>
				<a class="btn-ghost" href={ templ.SafeURL("/export/expenses.pdf") }>PDF exportieren</a>
			</div>
		}
		if nav.ActiveHousehold.ID == 0 {
			@noHousehold()
		} else {
			<div class="grid gap-4">
				for _, g := range vm.Groups {
					@expenseSection(g, vm)
				}
			</div>
		}
	}
}

templ expenseSection(g SectionGroup, vm ExpensesVM) {
	<div class="card-tight">
		<div class="card-head">
			<h2 class="text-base font-semibold text-slate-900 dark:text-slate-100">{ g.Title() }</h2>
			<span class="badge ml-auto">{ FormatEUR(g.TotalCents) } / Monat</span>
		</div>
		<div class="card-body">
			<div id={ "section-" + strconv.FormatInt(g.SectionID(), 10) } class="grid gap-1.5">
				for _, e := range g.Expenses {
					@ExpenseRowView(e, vm)
				}
			</div>
			<button
				class="btn-ghost mt-3 no-print"
				hx-post={ "/expenses/new?section_id=" + strconv.FormatInt(g.SectionID(), 10) }
				hx-target={ "#section-" + strconv.FormatInt(g.SectionID(), 10) }
				hx-swap="beforeend"
			>+ Ausgabe</button>
		</div>
	</div>
}

templ ExpenseRowView(e ExpenseRow, vm ExpensesVM) {
	<form
		id={ e.DOMID() }
		hx-post={ e.PostURL() }
		hx-trigger="change, keyup changed delay:700ms"
		hx-target="this"
		hx-swap="outerHTML"
	>
		// Carries the open state through the auto-save round trip.
		<input type="hidden" name="expanded" value={ e.ExpandedValue() } data-expanded-state/>
		<details class="exp" open?={ e.Expanded }>
			<summary class="exp-summary">
				<span class="exp-caret" aria-hidden="true">›</span>
				if e.Expense.Name == "" {
					<span class="min-w-0 flex-1 truncate italic text-slate-400 dark:text-slate-500">Ohne Bezeichnung</span>
				} else {
					<span class="min-w-0 flex-1 truncate font-medium text-slate-900 dark:text-slate-100">{ e.Expense.Name }</span>
				}
				<span class="hidden items-center gap-1.5 sm:flex">
					<span class="badge">{ e.RhythmLabel() }</span>
					<span class={ "badge", e.BudgetClassBadge() }>{ BudgetClassLabel(e.Expense.BudgetClass) }</span>
				</span>
				<span class="hidden items-center gap-1 sm:flex">
					for _, m := range vm.Members {
						if e.HasMember(m.ID) {
							@memberDot(m.Color)
						}
					}
				</span>
				<span class="tnum shrink-0 text-right text-sm font-semibold text-slate-900 dark:text-slate-100">
					{ FormatEUR(e.MonthlyCents()) }
					<span class="font-normal text-slate-400 dark:text-slate-500">/Mon.</span>
				</span>
			</summary>
			<div class="exp-body grid gap-4 p-4">
				<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
					<div class="sm:col-span-2">
						<label class="field-label" for={ "name-" + e.IDStr() }>Bezeichnung</label>
						<input id={ "name-" + e.IDStr() } class="input" type="text" name="name" value={ e.Expense.Name } placeholder="z. B. Miete"/>
					</div>
					<div>
						<label class="field-label" for={ "amount-" + e.IDStr() }>Betrag (€)</label>
						<input id={ "amount-" + e.IDStr() } class="input tnum" type="number" step="0.01" min="0" name="amount" value={ CentsToInput(e.Expense.AmountCents) }/>
					</div>
					<div>
						<label class="field-label" for={ "freq-" + e.IDStr() }>Rhythmus</label>
						<select id={ "freq-" + e.IDStr() } class="input" name="frequency">
							for _, opt := range FrequencyOptions() {
								<option value={ opt.Value } selected?={ opt.Value == string(e.Expense.Frequency) }>{ opt.Label }</option>
							}
						</select>
					</div>
				</div>
				<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
					<div>
						<label class="field-label" for={ "section-" + e.IDStr() }>Sektion</label>
						<select id={ "section-" + e.IDStr() } class="input" name="section_id">
							<option value="0" selected?={ e.Expense.SectionID == nil }>Ohne Sektion</option>
							for _, s := range vm.Sections {
								<option value={ strconv.FormatInt(s.ID, 10) } selected?={ e.Expense.SectionID != nil && *e.Expense.SectionID == s.ID }>{ s.Name }</option>
							}
						</select>
					</div>
					<div>
						<label class="field-label" for={ "category-" + e.IDStr() }>Kategorie</label>
						<select id={ "category-" + e.IDStr() } class="input" name="category_id">
							<option value="0" selected?={ e.Expense.CategoryID == nil }>— Kategorie —</option>
							for _, c := range vm.Categories {
								<option value={ strconv.FormatInt(c.ID, 10) } selected?={ e.Expense.CategoryID != nil && *e.Expense.CategoryID == c.ID }>{ c.Name }</option>
							}
						</select>
					</div>
					<div>
						<label class="field-label" for={ "nature-" + e.IDStr() }>Kostenart</label>
						<select id={ "nature-" + e.IDStr() } class="input" name="cost_nature">
							for _, opt := range CostNatureOptions() {
								<option value={ opt.Value } selected?={ opt.Value == string(e.Expense.CostNature) }>{ opt.Label }</option>
							}
						</select>
					</div>
					<div>
						<label class="field-label" for={ "class-" + e.IDStr() }>Klasse</label>
						<select id={ "class-" + e.IDStr() } class="input" name="budget_class">
							for _, opt := range BudgetClassOptions() {
								<option value={ opt.Value } selected?={ opt.Value == string(e.Expense.BudgetClass) }>{ opt.Label }</option>
							}
						</select>
					</div>
				</div>
				<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
					<label class="flex items-center gap-2 self-end pb-2 text-sm text-slate-700 dark:text-slate-300">
						<input class="checkbox" type="checkbox" name="is_oneoff" checked?={ e.Expense.IsOneOff }/>
						Einmalige Ausgabe
					</label>
					if e.Expense.IsOneOff {
						<div>
							<label class="field-label" for={ "date-" + e.IDStr() }>Datum</label>
							<input id={ "date-" + e.IDStr() } class="input" type="date" name="occurred_on" value={ e.Expense.OccurredOn }/>
						</div>
					} else {
						<div>
							<label class="field-label" for={ "from-" + e.IDStr() }>Gültig ab</label>
							<input id={ "from-" + e.IDStr() } class="input" type="month" name="active_from" value={ e.Expense.ActiveFrom }/>
						</div>
						<div>
							<label class="field-label" for={ "until-" + e.IDStr() }>Gültig bis (optional)</label>
							<input id={ "until-" + e.IDStr() } class="input" type="month" name="active_until" value={ e.Expense.ActiveUntil }/>
						</div>
					}
				</div>
				<div class="grid gap-3 lg:grid-cols-[minmax(0,14rem)_1fr]">
					<div>
						<label class="field-label" for={ "split-" + e.IDStr() }>Aufteilung</label>
						<select id={ "split-" + e.IDStr() } class="input" name="split_mode">
							for _, opt := range SplitModeOptions() {
								<option value={ opt.Value } selected?={ opt.Value == string(e.Expense.SplitMode) }>{ opt.Label }</option>
							}
						</select>
					</div>
					<div>
						<span class="field-label">Wer trägt die Ausgabe?</span>
						if e.Expense.SplitMode == store.SplitFixed && !e.Expense.IsOneOff && e.Expense.Frequency != store.FreqMonthly {
							<p class="mb-2 text-xs text-slate-500 dark:text-slate-400">
								Feste Beträge gelten je { FrequencyLabel(e.Expense.Frequency) } und werden für
								die Auswertung auf einen Monat umgerechnet.
							</p>
						}
						<div class="flex flex-wrap gap-2">
							for _, m := range vm.Members {
								<label class={ memberChipClass(e.HasMember(m.ID)) }>
									<input class="checkbox" type="checkbox" name={ "m_" + strconv.FormatInt(m.ID, 10) } checked?={ e.HasMember(m.ID) }/>
									@memberDot(m.Color)
									{ m.Name }
									if e.Expense.SplitMode == store.SplitPercent {
										<input class="input input-inline tnum w-16" type="number" step="0.1" min="0" max="100" name={ "v_" + strconv.FormatInt(m.ID, 10) } value={ e.PercentInput(m.ID) } aria-label={ "Anteil " + m.Name }/>
										<span class="text-xs text-slate-500">%</span>
									} else if e.Expense.SplitMode == store.SplitFixed {
										<input class="input input-inline tnum w-24" type="number" step="0.01" min="0" name={ "v_" + strconv.FormatInt(m.ID, 10) } value={ e.FixedInput(m.ID) } aria-label={ "Betrag " + m.Name }/>
										<span class="text-xs text-slate-500">€</span>
									}
								</label>
							}
						</div>
					</div>
				</div>
				<div class="flex items-center gap-2 border-t border-slate-200 pt-3 dark:border-slate-800">
					<div class="ml-auto"></div>
					@moveButtons("/expenses/" + e.IDStr())
					<button
						type="button"
						class="btn-danger"
						hx-post={ e.DeleteURL() }
						hx-target={ "#" + e.DOMID() }
						hx-swap="outerHTML"
						hx-confirm="Diese Ausgabe wirklich löschen?"
					>Löschen</button>
				</div>
			</div>
		</details>
	</form>
}
